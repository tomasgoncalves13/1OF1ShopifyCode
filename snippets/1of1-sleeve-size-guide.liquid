<script>
  (function () {
    if (window.oneofoneSizeGuideReady) return;
    window.oneofoneSizeGuideReady = true;

    // Delegated so triggers keep working after Dawn re-renders <variant-selects> on variant change
    document.addEventListener('click', function (e) {
      var trigger = e.target.closest('[data-oneofone-sg-open]');
      if (trigger) {
        var dialog = document.getElementById('oneofone-sg-' + trigger.dataset.oneofoneSgOpen);
        if (dialog) dialog.showModal();
        return;
      }
      var padBtn = e.target.closest('[data-sg-pad]');
      if (padBtn) {
        var guide = padBtn.closest('.oneofone-sg__dialog');
        guide.querySelectorAll('[data-sg-pad]').forEach(function (b) { b.classList.toggle('is-selected', b === padBtn); });
        guide.querySelectorAll('[data-sg-pad-panel]').forEach(function (p) { p.hidden = p.dataset.sgPadPanel !== padBtn.dataset.sgPad; });
        var pad = guide.querySelector('[data-sg-pad-graphic]');
        pad.style.setProperty('--pad-h', padBtn.dataset.padH);
        pad.style.setProperty('--pad-w', padBtn.dataset.padW);
        pad.style.fontSize = padBtn.dataset.padFs + 'px';
        pad.querySelector('[data-sg-pad-label]').textContent = padBtn.dataset.padH + '×' + padBtn.dataset.padW + ' cm';
        return;
      }
      var openDialog = e.target.closest('.oneofone-sg__dialog');
      if (!openDialog) return;
      if (e.target === openDialog || e.target.closest('[data-sg-close]')) openDialog.close();
    });
  })();
</script>
