<script>
(function () {
  if (window.__giftSizePickerReady) return;
  window.__giftSizePickerReady = true;

  // Meia oferta: adicionada quando o carrinho (sem a meia) chega aos 20 €.
  // O preço 0 € vem do desconto automático "Compre X, ganhe Y" do Shopify.
  const GIFT_VARIANTS = [55341001965902, 59226837025102]; // Branco / EU 40-48, Branco / EU 36-40
  const GIFT_DEFAULT = 55341001965902;
  const GIFT_MIN = 2000; // cêntimos
  const GIFT_PROPS = { _1of1_gift: '1' };

  const root = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
  const nativeFetch = window.fetch.bind(window);

  const post = (url, body) =>
    nativeFetch(root + url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify(body),
    }).then((r) => {
      if (!r.ok) throw new Error(url + ' ' + r.status);
      return r.json();
    });
  const getCart = () => nativeFetch(root + 'cart.js').then((r) => r.json());
  const isGift = (i) => i.properties && i.properties._1of1_gift;

  function render() {
    if (window.location.pathname.indexOf('/cart') !== -1 && !document.querySelector('cart-drawer.active')) {
      window.location.reload();
      return;
    }
    return nativeFetch(root + '?sections=cart-drawer,cart-icon-bubble')
      .then((r) => r.json())
      .then((sections) => {
        const drawer = document.querySelector('cart-drawer');
        const inner = document.getElementById('CartDrawer');
        if (drawer && inner && sections['cart-drawer']) {
          const html = new DOMParser().parseFromString(sections['cart-drawer'], 'text/html').querySelector('#CartDrawer');
          if (html) inner.innerHTML = html.innerHTML;
          const overlay = drawer.querySelector('#CartDrawer-Overlay');
          if (overlay) overlay.addEventListener('click', drawer.close.bind(drawer));
          drawer.classList.toggle('is-empty', !drawer.querySelector('.cart-item'));
        }
        const bubble = document.getElementById('cart-icon-bubble');
        if (bubble && sections['cart-icon-bubble']) {
          const b = new DOMParser().parseFromString(sections['cart-icon-bubble'], 'text/html').querySelector('.shopify-section');
          if (b) bubble.innerHTML = b.innerHTML;
        }
      });
  }

  let busy = false;
  let again = false;
  async function syncGift() {
    if (busy) { again = true; return; }
    busy = true;
    try {
      const cart = await getCart();
      const gifts = cart.items.filter(isGift);
      const total = cart.items.filter((i) => !isGift(i)).reduce((s, i) => s + i.final_line_price, 0);
      // Assinatura do carrinho (sem a meia): o bloqueio só vale enquanto o carrinho não mudar
      const sig = cart.items.filter((i) => !isGift(i)).map((i) => i.variant_id + 'x' + i.quantity).sort().join(',');
      let changed = false;

      if (total >= GIFT_MIN && gifts.some((g) => g.final_price > 0)) {
        console.warn('[1of1-gift] desconto não aplicado à meia oferta');
        const updates = {};
        gifts.forEach((g) => { updates[g.key] = 0; });
        await post('cart/update.js', { updates: updates });
        try { sessionStorage.setItem('1of1-gift-blocked', sig); } catch (e) {}
        changed = true;
      } else if (total >= GIFT_MIN) {
        if (gifts.length === 0) {
          let blocked = false;
          try { blocked = sessionStorage.getItem('1of1-gift-blocked') === sig; } catch (e) {}
          if (!blocked) {
            await post('cart/add.js', { items: [{ id: GIFT_DEFAULT, quantity: 1, properties: GIFT_PROPS }] });
            changed = true;
            // Se o desconto do Shopify não pôs a meia a 0 €, tirar e não voltar a tentar enquanto o carrinho não mudar
            const added = (await getCart()).items.find(isGift);
            if (added && added.final_price > 0) {
              console.warn('[1of1-gift] desconto não aplicado à meia oferta');
              await post('cart/change.js', { id: added.key, quantity: 0 });
              try { sessionStorage.setItem('1of1-gift-blocked', sig); } catch (e) {}
            }
          }
        } else if (gifts.length > 1 || gifts[0].quantity > 1) {
          const updates = {};
          gifts.forEach((g, n) => { updates[g.key] = n === 0 ? 1 : 0; });
          await post('cart/update.js', { updates: updates });
          changed = true;
        }
      } else if (gifts.length) {
        const updates = {};
        gifts.forEach((g) => { updates[g.key] = 0; });
        await post('cart/update.js', { updates: updates });
        changed = true;
      }

      if (changed) await render();
    } catch (err) {
      console.error('[1of1-gift]', err);
    } finally {
      busy = false;
      if (again) { again = false; syncGift(); }
    }
  }

  // Sempre que o tema (ou outra secção) mexe no carrinho, voltar a verificar a meia
  let timer = null;
  const schedule = () => { clearTimeout(timer); timer = setTimeout(syncGift, 400); };
  window.fetch = function (input, init) {
    const url = typeof input === 'string' ? input : (input && input.url) || '';
    const p = nativeFetch(input, init);
    if (/\/cart\/(add|change|update|clear)/.test(url)) p.then(schedule, schedule);
    return p;
  };
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', schedule);
  else schedule();

  // Bloco das meias (1of1-cart-pack) e linhas juntas (1of1-cart-merged-line): + / − um, ou remover todas
  document.addEventListener('click', function (e) {
    const btn = e.target.closest && e.target.closest('[data-oob-pack-remove], [data-oob-pack-add], [data-oob-pack-minus]');
    if (!btn) return;
    e.preventDefault();
    e.stopPropagation();
    btn.closest('tr').querySelectorAll('button').forEach((b) => { b.disabled = true; });

    let url, body;
    if (btn.dataset.oobPackAdd) {
      url = 'cart/add.js';
      body = { items: [{ id: Number(btn.dataset.oobPackAdd), quantity: 1 }] };
    } else if (btn.dataset.oobPackMinus) {
      url = 'cart/change.js';
      body = { id: btn.dataset.oobPackMinus, quantity: Number(btn.dataset.oobPackMinusQty) - 1 };
    } else {
      url = 'cart/update.js';
      body = { updates: {} };
      btn.dataset.oobPackRemove.split(',').forEach((key) => { body.updates[key] = 0; });
    }

    window.fetch(root + url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify(body),
    })
      .then(render)
      .catch((err) => {
        console.error('[1of1-pack]', err);
        window.location.reload();
      });
  }, true);

  // Troca de tamanho da meia oferta
  // Em fase de captura + stopPropagation: senão o <cart-drawer-items> do Dawn trata isto
  // como mudança de quantidade e faz /cart/change sem "line" ("O parâmetro line é inválido")
  document.addEventListener('change', function (e) {
    const select = e.target.closest && e.target.closest('[data-gift-size-picker]');
    if (!select) return;
    e.stopPropagation();
    const currentId = Number(select.dataset.currentVariant);
    const newId = Number(select.value);
    if (GIFT_VARIANTS.indexOf(newId) === -1) return;
    select.disabled = true;
    busy = true;

    (async function () {
      const cart = await getCart();
      const line = cart.items.find((i) => isGift(i) && i.variant_id === currentId);
      if (line) await post('cart/change.js', { id: line.key, quantity: 0 });
      await post('cart/add.js', { items: [{ id: newId, quantity: 1, properties: GIFT_PROPS }] });
      // Se o novo tamanho não ficou grátis, voltar ao tamanho anterior
      const added = (await getCart()).items.find((i) => isGift(i) && i.variant_id === newId);
      if (added && added.final_price > 0) {
        console.warn('[1of1-gift] desconto não aplicado à variante', newId);
        await post('cart/change.js', { id: added.key, quantity: 0 });
        await post('cart/add.js', { items: [{ id: currentId, quantity: 1, properties: GIFT_PROPS }] });
      }
      await render();
    })()
      .catch((err) => {
        console.error('[1of1-gift]', err);
        window.location.reload();
      })
      .finally(() => {
        busy = false;
      });
  }, true);
})();
</script>

<script>
(function () {
  let interval = null;
  let remaining = 300; // começa em 5:00
  let running = false;
  let loopMode = false; // false = primeira vez | true = loop 1:30

  function render() {
    const el = document.getElementById('reserveTimer');
    if (!el) return;
    const m = Math.floor(remaining / 60);
    const s = remaining % 60;
    el.textContent =
      String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0');
  }

  function start() {
    if (running) return;
    running = true;

    interval = setInterval(() => {
      const el = document.getElementById('reserveTimer');
      const drawer = document.querySelector('cart-drawer');

      if (!el || !drawer || !drawer.classList.contains('active')) return;

      if (remaining <= 0) {
        // 🔁 comportamento novo
        if (!loopMode) {
          loopMode = true;
          remaining = 90; // 1:30
        } else {
          remaining = 90; // fica sempre 1:30
        }
        render();
        return;
      }

      remaining--;
      render();
    }, 1000);
  }

  // 👁️ observa abertura REAL do drawer
  const drawer = document.querySelector('cart-drawer');
  if (!drawer) return;

  new MutationObserver(() => {
    if (drawer.classList.contains('active') && !running) {
      remaining = 300;   // reset só na primeira abertura
      loopMode = false;
      render();
      start();
    }
  }).observe(drawer, { attributes: true, attributeFilter: ['class'] });
})();
</script>


<script>
  document.addEventListener('DOMContentLoaded', function () {
    const cartDrawer = document.querySelector('cart-drawer');
    let scrollPosition = 0;

    if (!cartDrawer) return;

    const observer = new MutationObserver(() => {
      if (cartDrawer.classList.contains('active')) {
        scrollPosition = window.scrollY;
        document.body.classList.add('cart-drawer-open');
        document.body.style.top = `-${scrollPosition}px`;
      } else {
        document.body.classList.remove('cart-drawer-open');
        document.body.style.top = '';
        window.scrollTo(0, scrollPosition);
      }
    });

    observer.observe(cartDrawer, { attributes: true, attributeFilter: ['class'] });
  });
</script>



