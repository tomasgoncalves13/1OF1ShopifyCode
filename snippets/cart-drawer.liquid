<script>
document.addEventListener('click', async (e) => {
  const button = e.target.closest('.upsell-add button');
  if (!button) return;

  const variantId = button.dataset.variantId;
  const tAdding = "{{ 'cart_upsell.adding' | t }}";
  const tAdded  = "{{ 'cart_upsell.added'  | t }}";
  const tError  = "{{ 'cart_upsell.error'  | t }}";
  const tAdd    = "{{ 'cart_upsell.button' | t }}";

  button.disabled = true;
  button.textContent = tAdding;

  try {
    // 1️⃣ add ao carrinho
    await fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: variantId, quantity: 1 })
    });

    // 2️⃣ locale correto
    const locale =
      document.documentElement.lang ||
      Shopify?.locale ||
      '';

    const url = `${locale ? '/' + locale : ''}?sections=cart-drawer,cart-icon-bubble`;

    const sections = await fetch(url).then(r => r.json());

    // 3️⃣ usa APENAS o renderContents (🔥 chave)
    const cartDrawer = document.querySelector('cart-drawer');
    if (cartDrawer && sections['cart-drawer']) {
      cartDrawer.renderContents({
        sections: sections
      });
    }

    button.textContent = tAdded;
    setTimeout(() => {
      button.textContent = tAdd;
      button.disabled = false;
    }, 1200);

  } catch (err) {
    console.error(err);
    button.textContent = tError;
    setTimeout(() => {
      button.textContent = tAdd;
      button.disabled = false;
    }, 1200);
  }
});
</script>


