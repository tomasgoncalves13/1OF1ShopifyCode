  }
</style>

<script>
document.addEventListener("DOMContentLoaded", function() {
  function updateShippingStatus() {
    const cartValueElement = document.querySelector(".totals__total-value");
    const goalValueElement = document.querySelector(".lb-cpb-cart-goal-value-text.money");

    if (!cartValueElement || !goalValueElement) {
      requestAnimationFrame(updateShippingStatus);
      return;
    }

    let cartValueText = cartValueElement.innerText.replace(/[^\d,]/g, '').replace(',', '.');
    let cartValue = parseFloat(cartValueText);

    if (isNaN(cartValue)) {
      requestAnimationFrame(updateShippingStatus);
      return;
    }

    if (cartValue >= 45) {
      goalValueElement.innerHTML = `<img src="https://cdn.shopify.com/s/files/1/0907/8472/7374/files/free_1.png?v=1745672891" class="custom-progress-icon">`;
    } else {
      goalValueElement.innerHTML = `<img src="https://cdn.shopify.com/s/files/1/0907/8472/7374/files/free_2.png?v=1745677858" class="custom-progress-icon">`;
    }

    goalValueElement.style.display = "flex";
    goalValueElement.style.alignItems = "center";
    goalValueElement.style.justifyContent = "center";
    goalValueElement.style.background = "transparent";

    requestAnimationFrame(updateShippingStatus); // chama de novo para manter atualizado
  }

  updateShippingStatus();
});
</script>
<script>
  function initQuickBuyModal() {
  const modal = document.getElementById('quick-buy-modal');
  const image = modal.querySelector('#variant-main-image');
  const input = modal.querySelector('#variant-id-input');
  const addToCartBtn = modal.querySelector('#add-to-cart-button');
  const variantData = JSON.parse(modal.querySelector('script[data-variant-json]').textContent);

  let selectedOptions = {};

  function updateVariantSelection() {
    const selectedVariant = variantData.find(variant =>
      variant.options.every((opt, i) => selectedOptions[i] === opt)
    );

    if (selectedVariant) {
      input.value = selectedVariant.id;
      if (selectedVariant.featured_image) {
        image.src = selectedVariant.featured_image.src;
      }
      addToCartBtn.disabled = false;
    } else {
      input.value = '';
      addToCartBtn.disabled = true;
    }
  }

  // Adiciona event listeners
  const buttons = modal.querySelectorAll('.variant-button');
  buttons.forEach(button => {
    button.addEventListener('click', () => {
      const index = parseInt(button.getAttribute('data-option-index'));
      const value = button.getAttribute('data-option-value');

      modal.querySelectorAll(`.variant-button[data-option-index="${index}"]`).forEach(b => b.classList.remove('active'));
      button.classList.add('active');

      selectedOptions[index] = value;
      updateVariantSelection();
    });
  });

  // ⬅️ Clica nas primeiras variantes de cada grupo DEPOIS dos listeners estarem prontos
  const optionGroups = modal.querySelectorAll('.variant-options-wrapper');
  optionGroups.forEach(group => {
    const first = group.querySelector('.variant-button');
    if (first) first.click(); // isso dispara o listener acima
  });
}

</script>
