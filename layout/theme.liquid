<style>
html, body {
  overflow-y: auto !important;
  overscroll-behavior: auto !important;
}

#fixed-add-to-cart-wrapper {
  pointer-events: none;
}

#fixed-add-to-cart-wrapper.show {
  pointer-events: auto;
}

@media screen and (max-width: 749px) {
  .product__media-list {
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scroll-behavior: auto !important;
  }

  .product__media-item {
    scroll-snap-align: start;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const mediaList = document.querySelector('.product__media-list');
  if (!mediaList) return;

  const mediaItems = mediaList.querySelectorAll('.product__media-item');
  const thumbnailList = document.querySelector('.thumbnail-list.slider');
  const thumbnails = document.querySelectorAll('.thumbnail');
  if (!thumbnails.length) return;

  let touchStartX = 0;
  let currentIndex = 0;

  function getClosestIndex() {
    const listLeft = mediaList.getBoundingClientRect().left;
    let closest = 0;
    let minDist = Infinity;
    mediaItems.forEach((item, i) => {
      const dist = Math.abs(item.getBoundingClientRect().left - listLeft);
      if (dist < minDist) { minDist = dist; closest = i; }
    });
    return closest;
  }

  function scrollThumbnailIfNeeded(index, direction) {
    if (!thumbnailList) return;
    const thumb = thumbnails[index];
    if (!thumb) return;
    const thumbItem = thumb.closest('.thumbnail-list__item');
    if (!thumbItem) return;

    const listRect = thumbnailList.getBoundingClientRect();
    const itemRect = thumbItem.getBoundingClientRect();
    const itemWidth = thumbItem.offsetWidth;
    const visibleLeft = Math.floor((itemRect.left - listRect.left) / itemWidth);
    const visibleRight = Math.floor((listRect.right - itemRect.right) / itemWidth);
    if (visibleLeft >= 2 && visibleRight >= 2) return;

    const listWidth = thumbnailList.offsetWidth;
    const itemLeft = thumbItem.offsetLeft;

    let scrollTarget;
    if (direction === 'left') {
      scrollTarget = itemLeft - (listWidth - itemWidth * 3); // 2 visíveis à direita
    } else {
      scrollTarget = itemLeft - itemWidth * 2; // 2 visíveis à esquerda
    }

    thumbnailList.scrollTo({ left: scrollTarget, behavior: 'smooth' });
  }

  function updateThumbnails(index, direction) {
    thumbnails.forEach((thumb, i) => {
      i === index
        ? thumb.setAttribute('aria-current', 'true')
        : thumb.removeAttribute('aria-current');
    });
    scrollThumbnailIfNeeded(index, direction);
  }

  mediaList.addEventListener('touchstart', (e) => {
    touchStartX = e.touches[0].clientX;
  }, { passive: true });

  mediaList.addEventListener('touchend', (e) => {
    const diff = touchStartX - e.changedTouches[0].clientX;
    const threshold = 30;

    let predictedIndex = currentIndex;
    let direction = null;

    if (diff > threshold) {
      predictedIndex = Math.min(currentIndex + 1, mediaItems.length - 1);
      direction = 'left';
    } else if (diff < -threshold) {
      predictedIndex = Math.max(currentIndex - 1, 0);
      direction = 'right';
    }

    currentIndex = predictedIndex;
    updateThumbnails(currentIndex, direction);
  }, { passive: true });

  mediaList.addEventListener('scroll', function () {
    const idx = getClosestIndex();
    if (idx !== currentIndex) {
      const direction = idx > currentIndex ? 'left' : 'right';
      currentIndex = idx;
      updateThumbnails(currentIndex, direction);
    }
  });
});
</script>

