<script>
function showTab(tabId) {
  document.querySelectorAll('.tab').forEach(tab => tab.classList.remove('active'));
  document.querySelectorAll('.tab-content').forEach(content => content.classList.remove('active'));
  document.querySelector('.tab[data-tab="' + tabId + '"]').classList.add('active');
  document.getElementById(tabId).classList.add('active');
}

const tabs = ['shin', 'socks', 'bundles'];
const slideState = {};

tabs.forEach(tab => {
  const track = document.getElementById('carousel-track-' + tab);
  const slides = Array.from(track.children);
  const dotsContainer = document.getElementById('carousel-dots-' + tab);
  const totalSlides = slides.length;
  let index = 0;

  const cloneFirst = slides[0].cloneNode(true);
  const cloneLast = slides[totalSlides - 1].cloneNode(true);
  track.appendChild(cloneFirst);
  track.insertBefore(cloneLast, slides[0]);

  const newSlides = Array.from(track.children);
  track.style.transform = `translateX(-${(index + 1) * (newSlides[0].offsetWidth + 10)}px)`;

  slideState[tab] = { index, track, slides: newSlides, dotsContainer };

  updateDots(tab, index);

  slides.forEach((_, i) => {
    const dot = document.createElement('span');
    dot.className = 'carousel-dot';
    if (i === 0) dot.classList.add('active');
    dot.dataset.index = i;
    dot.addEventListener('click', () => updateCarousel(tab, i));
    dotsContainer.appendChild(dot);
  });

  let startX = 0;
  let isMoving = false;

  track.addEventListener('touchstart', e => {
    startX = e.touches[0].clientX;
    isMoving = true;
  });

  track.addEventListener('touchmove', e => {
    if (!isMoving) return;
    const dx = e.touches[0].clientX - startX;
    if (Math.abs(dx) > 50) {
      if (dx < 0) moveCarousel(tab, 'right');
      else moveCarousel(tab, 'left');
      isMoving = false;
    }
  });

  track.addEventListener('touchend', () => {
    isMoving = false;
  });
});

function updateCarousel(tab, i, animate = true) {
  const { track, slides, dotsContainer } = slideState[tab];
  const slideWidth = slides[0].offsetWidth + 10;
  const offset = (i + 1) * slideWidth;
  track.style.transition = animate ? 'transform 0.4s ease-in-out' : 'none';
  track.style.transform = `translateX(-${offset}px)`;
  slideState[tab].index = i;

  updateDots(tab, i);
}

function updateDots(tab, index) {
  const { dotsContainer } = slideState[tab];
  dotsContainer.querySelectorAll('span').forEach(dot => dot.classList.remove('active'));
  if (dotsContainer.children[index]) {
    dotsContainer.children[index].classList.add('active');
  }
}

function moveCarousel(tab, direction) {
  const state = slideState[tab];
  const total = state.slides.length - 2; // exclude clones

  if (direction === 'right') {
    state.index++;
    updateCarousel(tab, state.index, true);

    if (state.index >= total) {
      // Atualiza visualmente o dot antes do salto
      updateDots(tab, 0);
      setTimeout(() => {
        updateCarousel(tab, 0, false);
        state.index = 0;
      }, 400);
    }
  } else {
    state.index--;
    updateCarousel(tab, state.index, true);

    if (state.index < 0) {
      // Atualiza visualmente o dot antes do salto
      updateDots(tab, total - 1);
      setTimeout(() => {
        updateCarousel(tab, total - 1, false);
        state.index = total - 1;
      }, 400);
    }
  }
}

function openQuickBuy(handle) {
  const modal = document.getElementById('quick-buy-modal');
  const contentContainer = modal.querySelector('.quick-buy-content');

  // Mostra o modal com loading temporário
  modal.style.display = 'flex';
  contentContainer.innerHTML = '<p style="text-align:center;">Loading...</p>';

  // Busca o conteúdo da view personalizada
fetch('{{ localization.root_url }}/products/' + handle + '?view=quick-buy')

    .then(response => response.text())
    .then(html => {
      const parser = new DOMParser();
      const doc = parser.parseFromString(html, 'text/html');
      const modalContent = doc.querySelector('.quick-buy-content');
      if (modalContent) {
  contentContainer.innerHTML = modalContent.innerHTML;
  initQuickBuyModal(); // ⬅️ CHAMADA ESSENCIAL
} else {
  contentContainer.innerHTML = '<p>Erro ao carregar produto.</p>';
}
    })
    .catch(() => {
      contentContainer.innerHTML = '<p>Erro ao carregar produto.</p>';
    });
}

function closeQuickBuy() {
  const modal = document.getElementById('quick-buy-modal');
  modal.style.display = 'none';
}

function initQuickBuyModal() {
  const modal = document.getElementById('quick-buy-modal');
  const image = modal.querySelector('#variant-main-image');
  const input = modal.querySelector('#variant-id-input');
  const addToCartBtn = modal.querySelector('#add-to-cart-button');

  let selectedOptions = {};

const selectedVariant = JSON.parse(modal.querySelector('script[data-selected-variant]').textContent);
selectedVariant.options.forEach((value, index) => {
  selectedOptions[index] = value;
});
  
  const variantData = JSON.parse(modal.querySelector('script[data-variant-json]').textContent);

  function updateVariantSelection() {
    const selectedVariant = variantData.find(variant => {
      return variant.options.every((opt, i) => selectedOptions[i] === opt);
    });

    if (selectedVariant) {
      input.value = selectedVariant.id;
      if (selectedVariant.featured_image) {
        image.src = selectedVariant.featured_image.src;
      }
      addToCartBtn.disabled = false;
    } else {
      input.value = '';
      addToCartBtn.disabled = true;
    }
  }

  // Adicionar evento de clique a cada botão
  const buttons = modal.querySelectorAll('.variant-button');
  buttons.forEach(button => {
    button.addEventListener('click', () => {
      const index = parseInt(button.getAttribute('data-option-index'));
      const value = button.getAttribute('data-option-value');

      modal.querySelectorAll(`.variant-button[data-option-index="${index}"]`).forEach(b => b.classList.remove('active'));
      button.classList.add('active');

      selectedOptions[index] = value;

      updateVariantSelection();
    });
  });

  // Garantir que botões são clicados após os listeners estarem ativos
  setTimeout(() => {
    const optionGroups = modal.querySelectorAll('.variant-options-wrapper');
    optionGroups.forEach(group => {
      const firstButton = group.querySelector('.variant-button');
      if (firstButton) {
        firstButton.click(); // agora os listeners já estão prontos
      }
    });
  }, 0);
}


</script>


