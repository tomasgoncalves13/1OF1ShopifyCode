<div class="favourites-section">
  <div class="favourites-header">
    <div class="favourites-header-left">
      <div class="rating-badge">
        {{ 'favourites.rating_badge' | t }}
        <img src="https://cdn.shopify.com/s/files/1/0907/8472/7374/files/Design_sem_nome_31_2.png?v=1775505343" alt="{{ 'favourites.stars_alt' | t }}">
      </div>
      <h2>{{ 'favourites.title' | t }}</h2>
      <p>{{ 'favourites.subtitle' | t }}</p>
    </div>

    <div class="favourites-tabs">
      <div class="tabs">
        <button class="tab active" data-tab="shin" onclick="showTab('shin')">{{ 'favourites.tab_best_sellers' | t }}</button>
        <button class="tab" data-tab="socks" onclick="showTab('socks')">{{ 'favourites.tab_bundles' | t }}</button>
        <button class="tab" data-tab="bundles" onclick="showTab('bundles')">{{ 'favourites.tab_shin_pads' | t }}</button>
      </div>
    </div>
  </div>
</div>

{% assign tabs = "shin,socks,bundles" | split: "," %}
{% assign tab_handles = "shin-pad-sleeve,sock-sleeve,grip-socks,pre-szn-bundle-shin-pad-sleeve|12-pair-bundle-pro-grip-socks,pre-szn-bundle-shin-pad-sleeve,6-pair-bundle-pro-grip-socks,pro-package-kids-built-in-shin-pads|shin-pad-sleeve,mini-shin-pads,airflow,kids-built-in-shin-pads" | split: "|" %}

{% for tab in tabs %}
  <div id="{{ tab }}" class="tab-content{% if forloop.first %} active{% endif %}">
    <div class="carousel-viewport" ontouchstart="">
      <div class="carousel-track" id="carousel-track-{{ tab }}">
        {% assign handles = tab_handles[forloop.index0] | split: "," %}
        {% for handle in handles %}
          {% assign product = all_products[handle] %}
          <div class="product-card carousel-slidee">
            <div class="image-wrapper">
              <a href="{{ product.url }}" class="product-link">
                <img src="{{ product.featured_image | img_url: 'master' }}" alt="{{ product.title }}">
              </a>

              <div class="dzpb-overlay" style="position: absolute; top: 0; left: 0; z-index: 10; display: flex; flex-direction: column; gap: 0.4rem; padding: 0.8rem 0.9rem;">
                <div class="dzpb dzpb--disc">
                  <span class="dzpb__inner">
                    <span class="dzpb__text">Meias GRIP Grátis</span>
                  </span>
                </div>
              </div>

              <button class="quick-buy-button" onclick="openQuickBuy('{{ product.handle }}')">
                <img src="https://cdn.shopify.com/s/files/1/0907/8472/7374/files/Icons_10.png?v=1748384481" alt="{{ 'favourites.add_icon_alt' | t }}">
                {{ 'favourites.quick_buy' | t }}
              </button>
            </div>

            <div class="product-info">
              <div class="stars">
                <img src="https://cdn.shopify.com/s/files/1/0907/8472/7374/files/Design_sem_nome_31_2.png?v=1775505343" alt="{{ 'favourites.stars_alt' | t }}">
                <span>{{ 'favourites.reviews_count' | t }}</span>
              </div>
              <div class="title">{{ product.title }}</div>
              <div class="price">
                <span class="current">{{ product.price | money }}</span>
                {% if product.compare_at_price > product.price %}
                  <span class="old">{{ product.compare_at_price | money }}</span>
                {% endif %}
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
    <div class="carousel-controls-inline">
      <button class="carousel-button" onclick="moveCarousel('{{ tab }}', 'left')">
        <img src="https://cdn.shopify.com/s/files/1/0907/8472/7374/files/Icons_6.png?v=1748183986" alt="{{ 'favourites.left_arrow_alt' | t }}" />
      </button>
      <div class="carousel-dots" id="carousel-dots-{{ tab }}"></div>
      <button class="carousel-button" onclick="moveCarousel('{{ tab }}', 'right')">
        <img src="https://cdn.shopify.com/s/files/1/0907/8472/7374/files/Icons_7.png?v=1748183986" alt="{{ 'favourites.right_arrow_alt' | t }}" />
      </button>
    </div>

<div class="favourites-btn-wrapper">
  <a href="/collections/best-sellers" class="favourites-btn">Comprar Mais Vendidos</a> <!-- Link direto sem prefixo de idioma -->
</div>


