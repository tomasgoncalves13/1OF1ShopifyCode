<!-- Fonts -->
<style>
  @font-face {
    font-family: 'Poppins Medium';
    src: url('https://cdn.shopify.com/s/files/1/0907/8472/7374/files/poppins.medium.ttf?v=1747688794') format('truetype');
    font-weight: 500;
    font-style: normal;
  }

  @font-face {
    font-family: 'Poppins ExtraBold';
    src: url('https://cdn.shopify.com/s/files/1/0907/8472/7374/files/poppins.extrabold.ttf?v=1747688794') format('truetype');
    font-weight: 800;
    font-style: normal;
  }

  <style>
  @media screen and (min-width: 768px) {
    .our-story-padding-desktop {
      padding-top: 120px !important;
    }
  }
</style>

</style>

<!-- Section: Dark Story -->
<section style="background: #000; color: #fff; padding: 20px 20px 60px 20px; text-align: center;">

  <p style="max-width: 720px; margin: 0 auto 30px auto; font-size: 16px; line-height: 1.8; font-family: 'Poppins Medium', sans-serif !important;">
    {{ 'about_section.line1' | t }}<br><br>
    {{ 'about_section.line2' | t }}<br><br>
    {{ 'about_section.line3' | t }}
  </p>

  <a href="/pages/about-1of1-futbol" 
     style="background: yellow; padding: 14px 30px; font-weight: bold; border-radius: 30px; color: black; text-decoration: none; display: inline-block; margin-top: 20px; font-family: 'Poppins ExtraBold', sans-serif !important;">
    {{ 'about_section.button' | t }}
  </a>

</section>

<!-- Section: Carousel -->
<link rel="stylesheet" href="https://unpkg.com/swiper/swiper-bundle.min.css" />
<style>
.carousel-section {
  background: #000;
  padding: 60px 0 0 0; /* remove o padding-bottom */
  text-align: center;
   contain: layout;
   overflow-x: hidden;
  max-width: 100vw;
}

  .swiper-container {
    width: 100%;
    padding-bottom: 40px;
    overflow-x: hidden;
  max-width: 100vw;
  }

  .swiper-slide {
    transform: scale(0.8);
    transition: transform 0.4s;
    opacity: 0.5;
  }

  .swiper-slide-active {
    transform: scale(1);
    opacity: 1;
    z-index: 2;
  }

  .swiper-slide img {
    border-radius: 10px;
    width: 100%;
    max-width: 320px;
    height: auto;
  }

  .carousel-caption {
    color: white;
    font-size: 22px;
    font-family: 'Poppins ExtraBold', sans-serif !important;
    margin-top: 20px;
  }
  
    @media (max-width: 768px) {
    .roots-title {
      font-size: 25px !important;
      margin-top:20px !important;
    }
  }
  
</style>

<section class="carousel-section">
  <div class="swiper-container">
    <div class="swiper-wrapper">
      <div class="swiper-slide">
        <img src="https://cdn.shopify.com/s/files/1/0907/8472/7374/files/Design_sem_nome_27a3e5b2-0297-499c-99c0-372b5f4020c1.png?v=1748960482" alt="{{ 'carousel_section.inspiration' | t }}">
        <div class="carousel-caption">{{ 'carousel_section.inspiration' | t }}</div>
      </div>
      <div class="swiper-slide">
        <img src="https://cdn.shopify.com/s/files/1/0907/8472/7374/files/Design_sem_nome_1b3ee461-aab3-4985-85ff-c249e75a3d8f.png?v=1748897949" alt="{{ 'carousel_section.design' | t }}">
        <div class="carousel-caption">{{ 'carousel_section.design' | t }}</div>
      </div>
      <div class="swiper-slide">
        <img src="https://cdn.shopify.com/s/files/1/0907/8472/7374/files/67C87A77-EDBF-4C63-8A3B-0791418ECCF6.jpg?v=1748736934" alt="{{ 'carousel_section.product' | t }}">
        <div class="carousel-caption">{{ 'carousel_section.product' | t }}</div>
      </div>
      <div class="swiper-slide">
        <img src="https://cdn.shopify.com/s/files/1/0907/8472/7374/files/427A9409-284B-44E5-A705-1FE0C14960F1.jpg?v=1748736933" alt="{{ 'carousel_section.branding' | t }}">
        <div class="carousel-caption">{{ 'carousel_section.branding' | t }}</div>
      </div>
    </div>
  </div>
</section>


<script src="https://unpkg.com/swiper/swiper-bundle.min.js"></script>
<script>
  const swiper = new Swiper('.swiper-container', {
    loop: true,
    slidesPerView: 'auto',
    centeredSlides: true,
    spaceBetween: 30,
    autoplay: {
      delay: 2500,
      disableOnInteraction: false
    },
    breakpoints: {
      0: {
        slidesPerView: 1.4,
      },
      768: {
        slidesPerView: 3,
      }
    }
  });
</script>
