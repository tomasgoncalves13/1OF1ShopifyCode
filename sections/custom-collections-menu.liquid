<div class="top-feature-bar">
  <div class="feature">
    <img src="https://cdn.shopify.com/s/files/1/0907/8472/7374/files/GuaranteeIcon.png" alt="30-Day Guarantee" />
    <p>30-Day Guarantee</p>
  </div>
  <div class="feature">
    <img src="https://cdn.shopify.com/s/files/1/0907/8472/7374/files/FootballersIcon.png" alt="100,000+ Footballers" />
    <p>100,000+ Footballers</p>
  </div>
</div>

<div class="collections-menu-grid">

  <div class="collection-item">
    <a href="https://1of1futbol.com/collections/shin-pads">
      <img src="https://cdn.shopify.com/s/files/1/0907/8472/7374/files/2_80cd0925-d015-4d7e-be5c-65052b6265e4.png?v=1749294268" alt="Shin Pads">
      <div class="collection-info">
        <h3>Shin Pads</h3>
        <button>Shop Now</button>
      </div>
    </a>
  </div>

  <div class="collection-item">
    <a href="/collections/socks">
      <img src="https://cdn.shopify.com/s/files/1/0907/8472/7374/files/Colecoes_Menu.png?v=1749298022" alt="Grip Socks">
      <div class="collection-info">
        <h3>Grip Socks</h3>
        <button>Shop Now</button>
      </div>
    </a>
  </div>

  <div class="collection-item">
    <a href="/collections/kids">
      <img src="https://cdn.shopify.com/s/files/1/0907/8472/7374/files/4_cc0a06eb-26a7-4445-8479-e6046f1fbd04.png?v=1749294268" alt="Kids">
      <div class="collection-info">
        <h3>Kids</h3>
        <button>Shop Now</button>
      </div>
    </a>
  </div>

  <div class="collection-item">
    <a href="/collections/bundles">
      <img src="https://cdn.shopify.com/s/files/1/0907/8472/7374/files/6_d9ad91a5-df17-4ce8-8b32-b7dea5900980.png?v=1749294259" alt="Bundles">
      <div class="collection-info">
        <h3>Bundles</h3>
        <button>Shop Now</button>
      </div>
    </a>
  </div>

  <div class="collection-item">
    <a href="/collections/accessories">
      <img src="https://cdn.shopify.com/s/files/1/0907/8472/7374/files/7_6978b0b2-3032-43ef-97ab-d2fa16e93d76.png?v=1749294269" alt="Accessories">
      <div class="collection-info">
        <h3>Accessories</h3>
        <button>Shop Now</button>
      </div>
    </a>
  </div>

  <div class="collection-item">
    <a href="/collections/shop-all">
      <img src="https://cdn.shopify.com/s/files/1/0907/8472/7374/files/1_5c0a3d33-e60d-452a-a399-78cc763b6eae.png?v=1749294268" alt="Shop All">
      <div class="collection-info">
        <h3>Shop All</h3>
        <button>Shop Now</button>
      </div>
    </a>
  </div>

</div>

<style>
.top-feature-bar {
  display: flex;
  justify-content: space-around;
  background: #f9f9f9;
  padding: 12px 0;
  border-bottom: 1px solid #ddd;
}
.top-feature-bar .feature {
  text-align: center;
  font-size: 14px;
}
.top-feature-bar img {
  height: 24px;
  margin-bottom: 5px;
}

.collections-menu-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 20px;
  padding: 20px 10px;
}
.collection-item {
  position: relative;
  overflow: hidden;
  border-radius: 10px;
}
.collection-item img {
  width: 100%;
  height: auto;
  display: block;
  border-radius: 10px;
}
.collection-info {
  position: absolute;
  bottom: 10px;
  left: 10px;
  color: white;
  background: rgba(0,0,0,0.5);
  padding: 10px;
  border-radius: 8px;
}
.collection-info h3 {
  margin: 0 0 5px 0;
}
.collection-info button {
  background: #ffcd00;
  color: black;
  border: none;
  padding: 6px 12px;
  border-radius: 6px;
  font-weight: bold;
  cursor: pointer;
}
</style>
