<!-- Fonte Questrial e Poppins ExtraBold -->
<style>
  @font-face {
    font-family: 'Questrial';
    src: url('https://cdn.shopify.com/s/files/1/0907/8472/7374/files/Questrial-Regular.ttf?v=1746300481') format('truetype');
    font-weight: normal;
    font-style: normal;
  }
  @font-face {
    font-family: 'Poppins';
    src: url('https://cdn.shopify.com/s/files/1/0907/8472/7374/files/poppins.extrabold.ttf?v=1747688794') format('truetype');
    font-weight: 800;
    font-style: normal;
  }

  @media screen and (min-width: 1024px) {
    .compare-section-why-choose-mini {
      background-color: fff !important;
    }

    .compare-columns-wrapper-why-choose-mini {
      max-width: 1100px;
      margin: 0 auto !important;
    }

    .add-to-cart-wrapper-why-choose-mini {
      align-items: center !important;
    }

    .add-to-cart-section-why-choose-mini {
      text-align: center !important;
    }

    .add-to-cart-section-why-choose-mini button {
      padding: 15px 270px !important;
      font-size: 25px !important;
      margin-left: 0 !important;
    }

    .money-back-why-choose-mini {
      margin-left: 0 !important;
    }

    .main-image-left-whyballers {
      margin-top: -230px !important;
    }

    .main-image-right-whyballers {
      max-width: 180px !important;
      margin: 0 auto 2rem auto !important;
    }

    .compare-title-why-choose-mini {
      margin-bottom: 11rem !important;
      font-size: 40px !important;
    }

    .compare-subtitle-why-choose-mini {
      font-size: 18px !important;
    }
  }

  .feature-column-whyballers {
    text-align: center;
  }
  .feature-item-whyballers {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    margin-bottom: 2rem;
  }
  .feature-item-whyballers img {
    width: 28px;
    height: 28px;
    object-fit: contain;
  }
  .feature-text-whyballers {
    font-size: 1rem;
    line-height: 1.4;
  }
  .black-text-whyballers { color: #000; }
  .white-text-whyballers { color: #fff; }

  .compare-subtitle-why-choose-mini {
    font-family: 'Questrial', sans-serif !important;
    font-size: 1.1rem;
    letter-spacing: 0.05em;
    color: #000;
    text-transform: uppercase;
    margin-bottom: 0rem;
  }
  .compare-subtitle-why-choose-mini::after {
    content: "";
    display: block;
    width: 40px;
    height: 1px;
    background-color: #333333;
    margin: 0.5rem auto 0;
  }
  .compare-title-why-choose-mini {
    font-size: 24px;
    font-family: 'Poppins', sans-serif !important;
    font-weight: 800;
    color: #000;
    line-height: 1.3;
    margin: 10px auto;
    text-align: center;
    text-transform: uppercase;
    margin-bottom: 4rem;
  }

  .main-image-inside-whyballers {
    width: 100%;
    max-width: 300px;
    border-radius: 10px;
    margin-top: -85px;
    margin-bottom: 2rem;
  }

  .compare-section-why-choose-mini {
    background-color: fff;
    padding: 1rem 2rem;
    font-family: 'Helvetica Neue', sans-serif;
    min-height: 800px;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }

  .add-to-cart-section-why-choose-mini {
    margin-top: 3rem;
    text-align: center;
  }

  .add-to-cart-section-why-choose-mini button {
    width: 100%;
    margin-top: 6px;
    background-color: #fff304;
    color: #000;
    border: 1.5px solid #000;
    border-radius: 9999px;
    padding: 14px 30px;
    font-family: PoppinsBold, sans-serif;
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0px;
    text-transform: uppercase;
    cursor: pointer;
    transition: all .3s ease;
    outline: none;
    display: block;
    box-shadow: 0 4px 6px 2px #0000001a, 0 2px 4px -1px #0000000f;
    border: 1px solid #ffe304;
  }

  .add-to-cart-section-why-choose-mini button:hover {
    background-color: #000;
    color: #fff;
  }

  .add-to-cart-wrapper-why-choose-mini {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .money-back-why-choose-mini {
    margin-top: 1rem;
    display: flex;
    align-items: center;
    font-family: 'Questrial', sans-serif;
    font-size: 14px;
    color: #000;
    gap: 8px;
  }

  .money-back-why-choose-mini img {
    width: 20px;
    height: 20px;
    object-fit: contain;
  }

  @media screen and (max-width: 767px) {
    .main-image-left-whyballers {
      transform: scale(1.4);
      transform-origin: top center;
      margin-top: -130px !important;
      margin-bottom: 3rem !important;
    }

    .compare-title-why-choose-mini {
      font-size: 24px;
      font-family: 'Poppins', sans-serif !important;
      font-weight: 800;
      color: #000;
      line-height: 1.3;
      margin: 10px auto;
      text-align: center;
      text-transform: uppercase;
      margin-bottom: 3rem;
    }

    .add-to-cart-section-why-choose-mini button {
      font-size: 15px !important;
      padding: 10px 60px !important;
    }
  }
</style>

<!-- SECTION WHY CHOOSE MINI -->
<div class="compare-section-why-choose-mini">
  <hr style="border: none; border-top: 1px solid #000; margin: 0 0 2.5rem 0; width: 100vw; position: relative; left: 50%; transform: translateX(-50%);">

  <!-- TÍTULO -->
  <div style="text-align: center; margin-bottom: 2.5rem;">
    <div class="compare-subtitle-why-choose-mini">{{ 'compare_shin.subtitle' | t }}</div>
    <h2 class="compare-title-why-choose-mini">{{ 'compare_shin.title' | t }}</h2>
  </div>

  <!-- COLUNAS -->
  <div class="compare-columns-wrapper-why-choose-mini">
    <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 2rem; margin-top: 8rem;">

      <!-- COLUNA ESQUERDA — SUBSTITUÍDA -->
      <div style="background: #000; padding: 2rem; max-width: 420px; flex: 1; border-radius: 10px;" class="feature-column-whyballers">
        <img src="https://cdn.shopify.com/s/files/1/0907/8472/7374/files/Why_ballers_chooseasas_1.png?v=1765063077" class="main-image-inside-whyballers main-image-left-whyballers" alt="">

        <div class="feature-item-whyballers"><img src="https://cdn.shopify.com/s/files/1/0907/8472/7374/files/7_783a73cc-ea48-48aa-aeb2-714c29771dfc.png?v=1763238051"><div class="feature-text-whyballers white-text-whyballers">{{ 'compare.left_1' | t }}</div></div>

        <div class="feature-item-whyballers"><img src="https://cdn.shopify.com/s/files/1/0907/8472/7374/files/Design_semASSA_nome.png?v=1763238625"><div class="feature-text-whyballers white-text-whyballers">{{ 'compare.left_2' | t }}</div></div>

        <div class="feature-item-whyballers"><img src="https://cdn.shopify.com/s/files/1/0907/8472/7374/files/3_3ea23202-157c-441a-bc90-a9531d7f0426.png?v=1763238050"><div class="feature-text-whyballers white-text-whyballers">{{ 'compare.left_3' | t }}</div></div>

        <div class="feature-item-whyballers"><img src="https://cdn.shopify.com/s/files/1/0907/8472/7374/files/6_081fe6a5-983a-4fdf-ae47-868aa07e3152.png?v=1763238051"><div class="feature-text-whyballers white-text-whyballers">{{ 'compare.left_4' | t }}</div></div>

        <div class="feature-item-whyballers"><img src="https://cdn.shopify.com/s/files/1/0907/8472/7374/files/5_970b2e13-e90c-4c95-8e18-66cb0acc75e6.png?v=1763238050"><div class="feature-text-whyballers white-text-whyballers">{{ 'compare.left_5' | t }}</div></div>
      </div>

      <!-- COLUNA DIREITA — MANTEVE IGUAL -->
      <div style="border: 2px solid #000000; background: fff; padding: 2rem; max-width: 420px; flex: 1; border-radius: 10px;" class="feature-column-whyballers">
        <img src="https://cdn.shopify.com/s/files/1/0907/8472/7374/files/Design_sem_nome_20.png?v=1747696148" class="main-image-inside-whyballers main-image-right-whyballers" alt="">

        {% assign cross_icon = "https://cdn.shopify.com/s/files/1/0907/8472/7374/files/Design_sem_nome_19.png?v=1747694101" %}
        <div class="feature-item-whyballers"><img src="{{ cross_icon }}"><div class="feature-text-whyballers black-text-whyballers">{{ 'compare_shin.right_1' | t }}</div></div>
        <div class="feature-item-whyballers"><img src="{{ cross_icon }}"><div class="feature-text-whyballers black-text-whyballers">{{ 'compare_shin.right_2' | t }}</div></div>
        <div class="feature-item-whyballers"><img src="{{ cross_icon }}"><div class="feature-text-whyballers black-text-whyballers">{{ 'compare_shin.right_3' | t }}</div></div>
        <div class="feature-item-whyballers"><img src="{{ cross_icon }}"><div class="feature-text-whyballers black-text-whyballers">{{ 'compare_shin.right_4' | t }}</div></div>
        <div class="feature-item-whyballers"><img src="{{ cross_icon }}"><div class="feature-text-whyballers black-text-whyballers">{{ 'compare_shin.right_5' | t }}</div></div>
      </div>

    </div>
  </div>

  <!-- BOTÃO -->
  <div class="add-to-cart-section-why-choose-mini">
    <div class="add-to-cart-wrapper-why-choose-mini">
      <form method="post" action="/cart/add" class="product-form" data-type="add-to-cart-form">
        <input type="hidden" name="id" value="{{ product.variants.first.id }}">
        <button type="submit" name="add" class="product-form__submit button button--full-width">
          {{ 'products.product.add_to_cart' | t }}
        </button>
      </form>

      <div class="money-back-why-choose-mini">
        <img src="https://cdn.shopify.com/s/files/1/0907/8472/7374/files/Iconasas.png?v=1747770903">
        <span>{{ 'product_features.money_back' | t }}</span>
      </div>
    </div>
  </div>
</div>
