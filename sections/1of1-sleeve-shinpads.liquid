<section class="oneofone-sleeve-highlights">
  <div class="container">
    <div class="features-grid">
      {%- for block in section.blocks -%}
        <div class="feature-block" {{ block.shopify_attributes }}>
          {%- case block.settings.media_type -%}
            {%- when 'video' -%}
              {%- if block.settings.video -%}
                {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'auto', class: 'video-mobile' }}
              {%- endif -%}
            {%- when 'image' -%}
              {%- if block.settings.image -%}
                <picture>
                  {%- if block.settings.image_mobile -%}
                    <source media="(max-width: 768px)" srcset="{{ block.settings.image_mobile | image_url: width: 600 }}">
                  {%- endif -%}
                  <img
                    src="{{ block.settings.image | image_url: width: 800 }}"
                    alt="{{ block.settings.alt | escape }}"
                    width="{{ block.settings.image.width }}"
                    height="{{ block.settings.image.height }}"
                    loading="lazy"
                  >
                </picture>
              {%- endif -%}
          {%- endcase -%}
          <div class="feature-text">
            <h3>{{ block.settings.heading }}</h3>
            <p>{{ block.settings.text }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
@font-face {
  font-family: 'Anton';
  src: url('https://cdn.shopify.com/s/files/1/0907/8472/7374/files/Anton-Regular.ttf?v=1761583609') format('truetype');
}

@font-face {
  font-family: 'Poppins Medium';
  src: url('https://cdn.shopify.com/s/files/1/0907/8472/7374/files/poppins.medium.ttf?v=1747688794') format('truetype');
}

.oneofone-sleeve-highlights {
  padding: 60px 15px;
  background: fff;
  font-family: 'Poppins Medium', sans-serif;
  display: flex;
  justify-content: center;
}

.feature-block picture {
  display: contents;
}

.features-grid {
  display: grid;
  gap: 40px;
  width: 100%;
  max-width: 1200px;
}

/* Desktop layout */
@media (min-width: 769px) {
  .features-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .feature-block {
    border-radius: 15px;
    background: #fff;
    text-align: center;
    box-shadow: 0px 4px 12px rgba(0, 0, 0, 0.1);
    color: #000;
    overflow: hidden;
  }

.feature-block img,
.feature-block video {
  width: 100%;
  height: auto;
  aspect-ratio: 4 / 5;  /* Proporção 4:5 para as imagens */
  object-fit: cover;
  display: block;
  border-top-left-radius: 15px !important;  /* Arredonda apenas o lado superior esquerdo */
  border-top-right-radius: 15px !important;  /* Arredonda apenas o lado superior direito */
  margin: 0;
}


  .feature-text {
    padding: 15px 0px;
  }

  .feature-block h3 {
    font-size: 25px;
    font-family: 'Anton', sans-serif !important;
    font-weight: 700 !important;
    color: #000 !important;
    margin-bottom: 0 !important;
    text-transform: uppercase !important;
    text-align: center !important;
    margin-right: 10px;
  }

  .feature-block p {
    font-size: 14px;
    font-family: 'Poppins Medium', sans-serif !important;
    color: #000000BF !important;
    padding: 10px 20px;
    line-height: 1.6 !important;
    text-align: center !important;
    text-transform: none !important;
  }
}

/* Mobile layout */
@media (max-width: 768px) {
  .features-grid {
    display: grid;
    gap: 15px;
  }

  .feature-block {
    border-radius: 15px;
    display: flex;
    flex-direction: row;
    align-items: stretch;
    background: #fff;
    padding: 0;
    box-shadow: 0px 4px 12px rgba(0, 0, 0, 0.1);
    height: auto;
  }

  /* Remover o outline preto em volta do bloco */
  .feature-block {
    outline: none !important;
  }

  /* Título no mobile (20px) */
  .feature-block h3 {
    font-size: 20px !important; /* Ajustando o tamanho do título */
    font-family: 'Anton', sans-serif !important;
    color: #000 !important;
    margin-bottom: 5px !important; /* Ajustando a distância do título */
    padding: 0 20px 0 0 !important; /* Mesmo padding à direita do texto */
    text-align: left !important; /* Garantir alinhamento à esquerda */
  }

/* Texto no mobile (12px) */
.feature-block p {
  font-size: 12px !important; /* Ajustando o tamanho do texto */
  font-family: 'Poppins Medium', sans-serif !important;
  color: #000000BF !important;
  line-height: 1.4 !important; /* Ajustando o espaçamento entre as linhas */
  padding-left: 0px !important; /* Sem padding à esquerda */
  padding-right: 20px !important; /* Apenas 15px de padding à direita */
  text-align: left !important;
}

  /* Ajustar o alinhamento e o padding para que o texto fique alinhado com o título */
  .feature-text {
    flex: 1 !important;
    display: flex !important;
    flex-direction: column !important;
    justify-content: center !important;
    text-align: left !important;
    padding-left: 10px !important; /* Ajuste para alinhamento correto */
  }

  /* Limitar a largura do vídeo e da imagem */
/* Limitar a largura do vídeo e da imagem */
.feature-block .video-mobile {
  width: 136px !important;      /* Largura fixa de 136px para o vídeo no mobile */
  height: auto !important;
  aspect-ratio: auto !important;
  align-self: stretch !important;
  object-fit: cover !important;
  border-top-left-radius: 15px !important;  /* Arredonda apenas o lado superior esquerdo */
  border-bottom-left-radius: 15px !important;  /* Arredonda apenas o lado inferior esquerdo */
  margin-left: 0 !important;
  margin-right: 15px !important;  /* Espaçamento à direita da imagem */
}

/* Ajuste para as imagens no mobile */
.feature-block img {
  width: 136px !important;      /* Largura fixa de 136px para a imagem no mobile */
  height: auto !important;
  aspect-ratio: auto !important;
  align-self: stretch !important;
  object-fit: cover !important;
  border-top-left-radius: 15px !important;  /* Arredonda apenas o lado superior esquerdo */
  border-bottom-left-radius: 15px !important;  /* Arredonda apenas o lado inferior esquerdo */
  margin-left: 0 !important;
  margin-right: 15px !important; /* Espaçamento à direita da imagem */
}

  .oneofone-sleeve-highlights {
    padding-top: 0px !important;  /* Remover padding superior */
    padding-bottom: 0 !important;  /* Remover padding inferior */
  }
}
</style>

{% schema %}
{
  "name": "1of1 Sleeve Highlights",
  "tag": "section",
  "class": "section-1of1-sleeve-shinpads",
  "settings": [],
  "blocks": [
    {
      "type": "feature",
      "name": "Bloco",
      "settings": [
        {
          "type": "select",
          "id": "media_type",
          "label": "Tipo de média",
          "options": [
            { "value": "video", "label": "Vídeo" },
            { "value": "image", "label": "Imagem" }
          ],
          "default": "image"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Vídeo (apenas se tipo = Vídeo)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagem (apenas se tipo = Imagem)"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Imagem mobile (opcional)",
          "info": "Se não escolheres nenhuma, o telemóvel mostra a imagem de desktop acima."
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Texto alternativo da imagem"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Título",
          "default": "TÍTULO"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Texto",
          "default": "Descrição do bloco."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "1of1 Sleeve Highlights",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "media_type": "video",
            "heading": "TECNOLOGIA TTP",
            "text": "A Tecnologia TTP usa almofadas de alto desempenho que absorvem o impacto e distribuem a força pela caneleira, mantendo a tua perna protegida."
          }
        },
        {
          "type": "feature",
          "settings": {
            "media_type": "image",
            "alt": "Ícone de Leveza",
            "heading": "FEITAS PARA PROFISSIONAIS",
            "text": "Desenhadas para alta performance, estas caneleiras oferecem leveza sem sacrificar a resistência ao impacto, colocando-te em vantagem sobre o adversário."
          }
        },
        {
          "type": "feature",
          "settings": {
            "media_type": "image",
            "alt": "Ícone de Segurança",
            "heading": "ADERÊNCIA ANTI-DESLIZE",
            "text": "Equipadas com uma fita anti-deslizante, as Caneleiras 1OF1 permanecem no lugar durante todo o jogo, mantendo-te focado no jogo até ao apito final."
          }
        }
      ]
    }
  ]
}
{% endschema %}
