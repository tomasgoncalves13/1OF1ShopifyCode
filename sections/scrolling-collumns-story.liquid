<style>
.section-overlay {
  position: relative;
  z-index: 1;
}

.section-overlay .bottom-banner {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  pointer-events: none;
  z-index: 99;
}

.scrolling-gallery-section {
  background-color: black;
  padding: 20px 0;
  overflow: hidden;
  position: relative;
  z-index: 1;
  height: 500px;
}

.scrolling-gallery {
  display: flex;
  justify-content: center;
  gap: 10px;
  height: 500px;
}

.column {
  width: 120px;
  height: 100%;
  overflow: hidden;
  position: relative;
}

.loop {
  display: flex;
  flex-direction: column;
  animation: scroll-up 30s linear infinite;
}

.column.reverse .loop {
  animation: scroll-down 30s linear infinite;
}

@keyframes scroll-up {
  0%   { transform: translateY(0); }
  100% { transform: translateY(-50%); }
}

@keyframes scroll-down {
  0%   { transform: translateY(-50%); }
  100% { transform: translateY(0); }
}

.loop img {
  width: 100%;
  height: auto;
  margin-bottom: 10px;
  object-fit: cover;
  flex-shrink: 0;
}

  @media (min-width: 1024px) {
  .scrolling-gallery-section {
    margin-top: -20px;
  }
}
/* MOBILE - mostra 3 colunas */
@media (max-width: 1023px) {
  .scrolling-gallery-section {
    height: 350px;
  }

  .scrolling-gallery {
    height: 350px;
    gap: 10px;
  }

  .column {
    width: calc(100% / 3 - 10px);
  }

  .mobile-hide {
    display: none;
  }
}

/* DESKTOP - mostra 6 colunas */
@media (min-width: 1024px) {
  .scrolling-gallery-section {
    height: 600px;
  }

  .scrolling-gallery {
    height: 600px;
    gap: 15px;
  }

  .column {
    width: calc(100% / 6 - 30px);
    display: block;
  }
}
</style>

