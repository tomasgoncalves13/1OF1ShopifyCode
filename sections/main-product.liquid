}

/* shimmer effect */
.oneofone-mbway-shimmer {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 55%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.28), transparent);
  transform: translateX(-120%);
  animation: mbwayShimmer 2.4s ease-in-out infinite;
  pointer-events: none;
}

@keyframes mbwayShimmer {
  0% { transform: translateX(-120%); }
  100% { transform: translateX(220%); }
}


