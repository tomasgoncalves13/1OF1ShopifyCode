<section class="main-banner-blackfriday">
  <a href="{{ section.settings.link | default: 'https://1of1futbol.com/collections/best-sellers' }}">
    <picture>
      {%- if section.settings.desktop_image %}
        <source media="(min-width: 768px)" srcset="{{ section.settings.desktop_image | image_url: width: 3840 }}">
      {%- endif %}
      {%- if section.settings.mobile_image %}
        <img src="{{ section.settings.mobile_image | image_url: width: 1920 }}" alt="{{ section.settings.mobile_image.alt | default: 'Black Friday' }}" style="width:100%;height:auto;">
      {%- endif %}
    </picture>
  </a>
</section>

<style>
.main-banner-blackfriday {
  width: 100%;
  display: block;
  margin: 0;
  padding: 0;
}
</style>

{% schema %}
{
  "name": "Banner BF Homepage",
  "settings": [
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Imagem (desktop)",
      "info": "Usada em ecrãs a partir de 768px"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Imagem (telemóvel)"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link do banner"
    }
  ],
  "presets": [
    {
      "name": "Banner BF Homepage"
    }
  ]
}
{% endschema %}
