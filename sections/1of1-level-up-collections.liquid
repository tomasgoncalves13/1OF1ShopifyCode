{%- liquid
  assign uid = section.id | replace: '_', '-'
  assign featured = section.blocks | where: 'type', 'featured'
  assign slides = section.blocks | where: 'type', 'slide'
-%}

<div class="oneofone-lvlup oneofone-lvlup--{{ uid }}">
  <div class="oneofone-lvlup__inner">

    {%- if section.settings.heading != blank -%}
      <h2 class="oneofone-lvlup__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="oneofone-lvlup__layout">

      {%- if featured.size > 0 -%}
        {%- assign f = featured[0] -%}
        <div class="oneofone-lvlup__left">
          <a class="oneofone-lvlup__card" href="{{ f.settings.link | default: '#' }}" {{ f.shopify_attributes }}>
            <div class="oneofone-lvlup__bg">
              {%- if f.settings.image_desktop != blank -%}
                <img src="{{ f.settings.image_desktop | image_url: width: 1200 }}"
                     srcset="{{ f.settings.image_desktop | image_url: width: 600 }} 600w, {{ f.settings.image_desktop | image_url: width: 1000 }} 1000w, {{ f.settings.image_desktop | image_url: width: 1400 }} 1400w"
                     sizes="(min-width: 990px) 40vw, 100vw"
                     alt="{{ f.settings.image_desktop.alt | escape }}"
                     class="oneofone-lvlup__img oneofone-lvlup__img--desktop"
                     loading="lazy" width="1000" height="1250">
              {%- endif -%}
              {%- if f.settings.image_mobile != blank -%}
                <img src="{{ f.settings.image_mobile | image_url: width: 800 }}"
                     alt="{{ f.settings.image_mobile.alt | escape }}"
                     class="oneofone-lvlup__img oneofone-lvlup__img--mobile"
                     loading="lazy" width="1000" height="1250">
              {%- elsif f.settings.image_desktop != blank -%}
                <img src="{{ f.settings.image_desktop | image_url: width: 800 }}"
                     alt="{{ f.settings.image_desktop.alt | escape }}"
                     class="oneofone-lvlup__img oneofone-lvlup__img--mobile"
                     loading="lazy" width="1000" height="1250">
              {%- endif -%}
            </div>

            <div class="oneofone-lvlup__content">
              {%- if f.settings.tag != blank -%}
                <span class="oneofone-lvlup__tag">{{ f.settings.tag }}</span>
              {%- endif -%}
              <div class="oneofone-lvlup__content-wrapper">
                <div class="oneofone-lvlup__content-inner">
                  {%- if f.settings.title != blank -%}
                    <h3 class="oneofone-lvlup__title">{{ f.settings.title }}</h3>
                  {%- endif -%}
                </div>
                {%- if f.settings.button_label != blank -%}
                  <span class="oneofone-lvlup__button">{{ f.settings.button_label }}</span>
                {%- endif -%}
              </div>
            </div>
          </a>
        </div>
      {%- endif -%}

      {%- if slides.size > 0 -%}
        <div class="oneofone-lvlup__right">
          <div class="oneofone-lvlup__slider" data-oneofone-lvlup-slider>
            <div class="oneofone-lvlup__track" data-oneofone-lvlup-track>
              {%- for s in slides -%}
                <a class="oneofone-lvlup__slide oneofone-lvlup__card" href="{{ s.settings.link | default: '#' }}" {{ s.shopify_attributes }}>
                  <div class="oneofone-lvlup__bg">
                    {%- if s.settings.image_desktop != blank -%}
                      <img src="{{ s.settings.image_desktop | image_url: width: 1200 }}"
                           srcset="{{ s.settings.image_desktop | image_url: width: 600 }} 600w, {{ s.settings.image_desktop | image_url: width: 1000 }} 1000w, {{ s.settings.image_desktop | image_url: width: 1400 }} 1400w"
                           sizes="(min-width: 990px) 22vw, 80vw"
                           alt="{{ s.settings.image_desktop.alt | escape }}"
                           class="oneofone-lvlup__img oneofone-lvlup__img--desktop"
                           loading="lazy" width="1600" height="1150">
                    {%- endif -%}
                    {%- if s.settings.image_mobile != blank -%}
                      <img src="{{ s.settings.image_mobile | image_url: width: 800 }}"
                           alt="{{ s.settings.image_mobile.alt | escape }}"
                           class="oneofone-lvlup__img oneofone-lvlup__img--mobile"
                           loading="lazy" width="1000" height="1250">
                    {%- elsif s.settings.image_desktop != blank -%}
                      <img src="{{ s.settings.image_desktop | image_url: width: 800 }}"
                           alt="{{ s.settings.image_desktop.alt | escape }}"
                           class="oneofone-lvlup__img oneofone-lvlup__img--mobile"
                           loading="lazy" width="1000" height="1250">
                    {%- endif -%}
                  </div>

                  <div class="oneofone-lvlup__content">
                    {%- if s.settings.tag != blank -%}
                      <span class="oneofone-lvlup__tag">{{ s.settings.tag }}</span>
                    {%- endif -%}
                    <div class="oneofone-lvlup__content-wrapper">
                      <div class="oneofone-lvlup__content-inner">
                        {%- if s.settings.title != blank -%}
                          <h3 class="oneofone-lvlup__title">{{ s.settings.title }}</h3>
                        {%- endif -%}
                      </div>
                      {%- if s.settings.button_label != blank -%}
                        <span class="oneofone-lvlup__button">{{ s.settings.button_label }}</span>
                      {%- endif -%}
                    </div>
                  </div>
                </a>
              {%- endfor -%}
            </div>
            <div class="oneofone-lvlup__dots" data-oneofone-lvlup-dots aria-hidden="true"></div>
          </div>
        </div>
      {%- endif -%}

    </div>
  </div>
</div>

<style>
  @font-face { font-family: 'PoppinsExtraBold'; src: url('https://cdn.shopify.com/s/files/1/0907/8472/7374/files/poppins.extrabold.ttf?v=1747688794') format('truetype'); }
  @font-face { font-family: 'PoppinsBold';      src: url('https://cdn.shopify.com/s/files/1/0907/8472/7374/files/poppins.bold.ttf?v=1747688795') format('truetype'); }
  @font-face { font-family: 'PoppinsSemiBold';  src: url('https://cdn.shopify.com/s/files/1/0907/8472/7374/files/poppins.semibold.ttf?v=1747688794') format('truetype'); }
  @font-face { font-family: 'PoppinsMedium';    src: url('https://cdn.shopify.com/s/files/1/0907/8472/7374/files/poppins.medium.ttf?v=1747688794') format('truetype'); }
  @font-face { font-family: 'PoppinsLight';     src: url('https://cdn.shopify.com/s/files/1/0907/8472/7374/files/poppins.light.ttf?v=1748130416') format('truetype'); }
  @font-face { font-family: 'MontserratExtraBold'; src: url('https://cdn.shopify.com/s/files/1/0907/8472/7374/files/Montserrat-ExtraBold.ttf?v=1775402219') format('truetype'); font-display: swap; }
  @font-face { font-family: 'MontserratBold';      src: url('https://cdn.shopify.com/s/files/1/0907/8472/7374/files/Montserrat-Bold.ttf?v=1775402219') format('truetype'); font-display: swap; }
  @font-face { font-family: 'MontserratSemiBold';  src: url('https://cdn.shopify.com/s/files/1/0907/8472/7374/files/Montserrat-SemiBold.ttf?v=1775402091') format('truetype'); font-display: swap; }
  @font-face { font-family: 'MontserratMedium';    src: url('https://cdn.shopify.com/s/files/1/0907/8472/7374/files/Montserrat-Medium.ttf?v=1775402219') format('truetype'); font-display: swap; }
  @font-face { font-family: 'Montserratregular';   src: url('https://cdn.shopify.com/s/files/1/0907/8472/7374/files/Montserrat-Regular.ttf?v=1775402219') format('truetype'); font-display: swap; }

  .oneofone-lvlup--{{ uid }} {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px 0;
    background: {{ section.settings.bg_color }};
    font-family: 'PoppinsMedium', sans-serif;
  }
  .oneofone-lvlup--{{ uid }} .oneofone-lvlup__inner {
    max-width: 1500px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .oneofone-lvlup--{{ uid }} .oneofone-lvlup__heading {
    font-family: 'PoppinsExtraBold', sans-serif !important;
    font-size: 24px;
    line-height: 1.05;
    margin: 0 0 28px;
    text-align: center;
    color: {{ section.settings.heading_color }};
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  .oneofone-lvlup--{{ uid }} .oneofone-lvlup__layout {
    display: grid;
    grid-template-columns: 40fr 60fr;
    gap: 16px;
    align-items: stretch;
  }
  .oneofone-lvlup--{{ uid }} .oneofone-lvlup__left,
  .oneofone-lvlup--{{ uid }} .oneofone-lvlup__right { min-width: 0; }

  .oneofone-lvlup--{{ uid }} .oneofone-lvlup__card {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 14px;
    aspect-ratio: 4 / 5;
    color: #fff;
    text-decoration: none;
    isolation: isolate;
  }
  .oneofone-lvlup--{{ uid }} .oneofone-lvlup__left .oneofone-lvlup__card { aspect-ratio: auto; height: 100%; min-height: 520px; }
  .oneofone-lvlup--{{ uid }} .oneofone-lvlup__bg {
    position: absolute; inset: 0; z-index: 0;
  }
  .oneofone-lvlup--{{ uid }} .oneofone-lvlup__img {
    width: 100%; height: 100%; object-fit: cover; display: block;
    transition: transform .6s ease;
  }
  .oneofone-lvlup--{{ uid }} .oneofone-lvlup__card:hover .oneofone-lvlup__img { transform: scale(1.04); }
  .oneofone-lvlup--{{ uid }} .oneofone-lvlup__img--mobile { display: none; }
  .oneofone-lvlup--{{ uid }} .oneofone-lvlup__bg::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0) 45%, rgba(0,0,0,0.55) 100%);
    pointer-events: none;
  }

  .oneofone-lvlup--{{ uid }} .oneofone-lvlup__content {
    position: relative; z-index: 1;
    display: flex; flex-direction: column;
    height: 100%;
    padding: 20px;
    justify-content: flex-end;
    text-align: left;
  }
  .oneofone-lvlup--{{ uid }} .oneofone-lvlup__tag {
    position: absolute; top: 16px; left: 16px;
    background: linear-gradient(135deg, #fb770f, #ffba06);
    font-family: 'MontserratExtraBold', sans-serif !important;
    color: #fff;
    text-transform: uppercase;
    font-size: 10px;
    letter-spacing: 0.06em;
    padding: 6px 12px; border-radius: 999px;
    box-shadow: 0 3px 12px #fb770f52;
    overflow: hidden;
    isolation: isolate;
  }
  .oneofone-lvlup--{{ uid }} .oneofone-lvlup__tag::after {
    content: '';
    position: absolute;
    top: 0; bottom: 0; left: 0;
    width: 55%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.45), transparent);
    transform: translateX(-120%);
    animation: oneofone-lvlup-tag-shine 2.4s ease-in-out infinite;
    pointer-events: none;
    z-index: 1;
  }
  @keyframes oneofone-lvlup-tag-shine {
    0%   { transform: translateX(-120%); }
    100% { transform: translateX(220%); }
  }
  .oneofone-lvlup--{{ uid }} .oneofone-lvlup__content-wrapper {
    display: flex; flex-direction: column; gap: 14px;
  }
  .oneofone-lvlup--{{ uid }} .oneofone-lvlup__title {
    font-family: 'PoppinsExtraBold', sans-serif !important;
    font-size: clamp(22px, 2vw, 32px);
    margin: 0;
    color: #fff;
    text-shadow: 1px 1px 4px rgba(0,0,0,0.8);
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  .oneofone-lvlup--{{ uid }} .oneofone-lvlup__button {
    align-self: flex-start;
    display: inline-block;
    padding: 12px 22px;
    background: {{ section.settings.button_bg }};
    color: {{ section.settings.button_color }};
    border-radius: 12px;
    font-family: 'PoppinsBold', sans-serif;
    font-size: 12px;
    letter-spacing: 0.08em; text-transform: uppercase;
    transition: transform .2s ease, background .2s ease;
  }
  .oneofone-lvlup--{{ uid }} .oneofone-lvlup__card:hover .oneofone-lvlup__button {
    transform: translateY(-1px);
  }

  .oneofone-lvlup--{{ uid }} .oneofone-lvlup__slider { position: relative; }
  .oneofone-lvlup--{{ uid }} .oneofone-lvlup__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 32px) / 3);
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-bottom: 4px;
  }
  .oneofone-lvlup--{{ uid }} .oneofone-lvlup__track::-webkit-scrollbar { display: none; }
  .oneofone-lvlup--{{ uid }} .oneofone-lvlup__slide { scroll-snap-align: start; aspect-ratio: 4 / 5; }
  .oneofone-lvlup--{{ uid }} .oneofone-lvlup__dots {
    display: none;
    justify-content: center;
    gap: 8px;
    margin-top: 14px;
  }
  .oneofone-lvlup--{{ uid }} .oneofone-lvlup__dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: rgba(0,0,0,0.25); border: none; padding: 0; cursor: pointer;
    transition: background .2s ease, transform .2s ease;
  }
  .oneofone-lvlup--{{ uid }} .oneofone-lvlup__dot.is-active {
    background: {{ section.settings.heading_color }};
    transform: scale(1.2);
  }

  @media (max-width: 989px) {
    .oneofone-lvlup--{{ uid }} .oneofone-lvlup__layout { grid-template-columns: 1fr; gap: 14px; }
    .oneofone-lvlup--{{ uid }} .oneofone-lvlup__left .oneofone-lvlup__card { aspect-ratio: 4/5; min-height: 0; }
    .oneofone-lvlup--{{ uid }} .oneofone-lvlup__track { grid-auto-columns: 80%; }
    .oneofone-lvlup--{{ uid }} .oneofone-lvlup__dots { display: flex; }
    .oneofone-lvlup--{{ uid }} .oneofone-lvlup__img--desktop { display: none; }
    .oneofone-lvlup--{{ uid }} .oneofone-lvlup__img--mobile { display: block; }
  }

  @media (max-width: 580px) {
    .oneofone-lvlup--{{ uid }} .oneofone-lvlup__inner { padding: 0 14px; }
    .oneofone-lvlup--{{ uid }} .oneofone-lvlup__track { grid-auto-columns: 85%; gap: 12px; }
  }
</style>

<script>
  (function () {
    var root = document.querySelector('.oneofone-lvlup--{{ uid }}');
    if (!root || root.dataset.oneofoneLvlupReady === '1') return;
    root.dataset.oneofoneLvlupReady = '1';

    var track = root.querySelector('[data-oneofone-lvlup-track]');
    var dotsWrap = root.querySelector('[data-oneofone-lvlup-dots]');
    if (!track || !dotsWrap) return;

    var slides = Array.from(track.querySelectorAll('.oneofone-lvlup__slide'));
    if (slides.length < 2) return;

    slides.forEach(function (_, i) {
      var b = document.createElement('button');
      b.type = 'button';
      b.className = 'oneofone-lvlup__dot' + (i === 0 ? ' is-active' : '');
      b.setAttribute('aria-label', 'Ir para slide ' + (i + 1));
      b.addEventListener('click', function () {
        slides[i].scrollIntoView({ behavior: 'smooth', inline: 'start', block: 'nearest' });
      });
      dotsWrap.appendChild(b);
    });

    var dots = Array.from(dotsWrap.children);
    var ticking = false;
    track.addEventListener('scroll', function () {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function () {
        var trackRect = track.getBoundingClientRect();
        var trackCenter = trackRect.left + trackRect.width / 2;
        var closest = 0;
        var minDist = Infinity;
        slides.forEach(function (s, i) {
          var r = s.getBoundingClientRect();
          var c = r.left + r.width / 2;
          var d = Math.abs(c - trackCenter);
          if (d < minDist) { minDist = d; closest = i; }
        });
        dots.forEach(function (d, i) { d.classList.toggle('is-active', i === closest); });
        ticking = false;
      });
    }, { passive: true });
  })();
</script>

{% schema %}
{
  "name": "1of1 Level Up Collections",
  "tag": "section",
  "class": "section-1of1-level-up",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Eleva o teu jogo"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Alinhamento do título",
      "options": [
        { "value": "left", "label": "Esquerda" },
        { "value": "center", "label": "Centro" },
        { "value": "right", "label": "Direita" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Cores"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Fundo da section",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Cor do título",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "tag_bg",
      "label": "Fundo da tag",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "tag_color",
      "label": "Texto da tag",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Fundo do botão",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Texto do botão",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Espaçamento"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding topo",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding fundo",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "featured",
      "name": "Cartão grande (esquerda)",
      "limit": 1,
      "settings": [
        { "type": "image_picker", "id": "image_desktop", "label": "Imagem (desktop)" },
        { "type": "image_picker", "id": "image_mobile",  "label": "Imagem (mobile) — opcional" },
        { "type": "text",         "id": "tag",           "label": "Tag (ex.: Bestseller)" },
        { "type": "text",         "id": "title",         "label": "Título",     "default": "Caneleiras" },
        { "type": "text",         "id": "button_label",  "label": "Botão",      "default": "VER CANELEIRAS" },
        { "type": "url",          "id": "link",          "label": "Link" }
      ]
    },
    {
      "type": "slide",
      "name": "Slide (direita)",
      "settings": [
        { "type": "image_picker", "id": "image_desktop", "label": "Imagem (desktop)" },
        { "type": "image_picker", "id": "image_mobile",  "label": "Imagem (mobile) — opcional" },
        { "type": "text",         "id": "tag",           "label": "Tag" },
        { "type": "text",         "id": "title",         "label": "Título" },
        { "type": "text",         "id": "button_label",  "label": "Botão" },
        { "type": "url",          "id": "link",          "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "1of1 Level Up Collections",
      "blocks": [
        { "type": "featured", "settings": { "title": "Caneleiras",         "tag": "Bestseller", "button_label": "VER CANELEIRAS" } },
        { "type": "slide",    "settings": { "title": "Packs Performance",                       "button_label": "VER PACKS" } },
        { "type": "slide",    "settings": { "title": "Meias",                                   "button_label": "VER MEIAS" } },
        { "type": "slide",    "settings": { "title": "Acessórios",                              "button_label": "VER ACESSÓRIOS" } }
      ]
    }
  ]
}
{% endschema %}
