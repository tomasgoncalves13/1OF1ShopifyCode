<style>
@font-face {
  font-family: 'Poppins Medium';
  src: url('https://cdn.shopify.com/s/files/1/0907/8472/7374/files/poppins.medium.ttf?v=1747688794') format('truetype');
  font-weight: 500;
  font-style: normal;
}

@font-face {
  font-family: 'Poppins ExtraBold';
  src: url('https://cdn.shopify.com/s/files/1/0907/8472/7374/files/poppins.extrabold.ttf?v=1747688794') format('truetype');
  font-weight: 800;
  font-style: normal;
}

.mission-wrapper {
  background: fff;
  text-align: center;
  padding: 40px 20px 80px 20px; /* Reduzido padding-top */
  color: #111;
  font-family: 'Poppins Medium', sans-serif !important;
  margin-top: -20px !important; /* Cola à secção anterior */
  margin-bottom: 0 !important;
}


.mission-title {
  font-size: 38px;
  font-family: 'Poppins ExtraBold', sans-serif !important;
  font-weight: 800 !important;
  margin-bottom: 30px;
  text-transform: uppercase;
  letter-spacing: -0.5px;
}

.mission-paragraph {
  max-width: 820px;
  margin: 0 auto;
  font-size: 17px;
  line-height: 1.8;
  font-family: 'Poppins Medium', sans-serif !important;
  text-align: center;
}

.mission-image {
  margin-top: 50px;
  width: 100vw; /* ocupa a largura total da viewport */
  max-width: 100vw; /* remove limite anterior */
  border-radius: 0 !important; /* sem cantos arredondados */
  display: block;
  margin: 0 auto;
  position: relative;
  left: 50%;
  transform: translateX(-50%); /* centraliza compensando o width total */
}


@media (max-width: 768px) {
  .mission-wrapper {
    padding: 50px 16px;
      margin-top: 0 !important;
  padding-top: 0 !important;
  }

  .mission-title {
    font-size: 22px;
    margin-bottom: 25px;
  }

  .mission-paragraph {
    font-size: 14px;
    line-height: 1.6;
    padding: 0 12px;
  }

.mission-image {
  margin-top: 50px;
  width: 100vw; /* ocupa a largura total da viewport */
  max-width: 100vw; /* remove limite anterior */
  border-radius: 0 !important; /* sem cantos arredondados */
  display: block;
  margin: 0 auto;
  position: relative;
  left: 50%;
  transform: translateX(-50%); /* centraliza compensando o width total */
}

  /* Elimina espaço entre missão e galeria */
.mission-wrapper {
  margin-bottom: 0 !important;
  padding-bottom: 0 !important;
}

.section-overlay {
  margin-top: -1px !important;
  padding-top: 0 !important;
}

.scrolling-gallery-section {
  margin-top: 0 !important;
  padding-top: 0 !important;
}

.section-overlay .top-banner {
  display: block;
  margin: 0 !important;
  padding: 0 !important;
  line-height: 0 !important;
  height: auto;
}

}
</style>

<section class="mission-wrapper">
  <h2 class="mission-title">{{ 'mission_section.title' | t }}</h2>
  <p class="mission-paragraph">
    {{ 'mission_section.p1' | t }} <br>
    {{ 'mission_section.p2' | t }} <br><br>
    {{ 'mission_section.p3' | t }} <br>
    {{ 'mission_section.p4' | t }}
  </p>

  <img 
    src="https://cdn.shopify.com/s/files/1/0907/8472/7374/files/Banners_Desktop_4_3ef1fc7f-0b91-46cc-8934-ea2adfadbc0a.png?v=1748912760" 
    alt="{{ 'mission_section.banner_alt' | t }}" 
    class="mission-image"
  >
</section>

