<style>
  @font-face {
    font-family: 'Questrial';
    src: url('https://cdn.shopify.com/s/files/1/0907/8472/7374/files/Questrial-Regular.ttf?v=1746300481') format('truetype');
  }

  @font-face {
    font-family: 'PoppinsExtraBold';
    src: url('https://cdn.shopify.com/s/files/1/0907/8472/7374/files/poppins.extrabold.ttf?v=1747688794') format('truetype');
    font-weight: 800;
    font-style: normal;
  }

  @font-face {
    font-family: 'PoppinsMedium';
    src: url('https://cdn.shopify.com/s/files/1/0907/8472/7374/files/poppins.medium.ttf?v=1747688794') format('truetype');
    font-weight: 500;
    font-style: normal;
  }

  @font-face {
    font-family: 'PoppinsLight';
    src: url('https://cdn.shopify.com/s/files/1/0907/8472/7374/files/poppins.light.ttf?v=1748130416') format('truetype');
    font-weight: 300;
    font-style: normal;
  }

  /* ----------- VIDEO GRID 4x ----------- */

  .video-sleeve-carousel-wrapper3 {
    position: relative;
    padding: 40px 0;
    background: fff;
  }

  .video-sleeve-subtitle3 {
    font-family: 'PoppinsMedium', sans-serif;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #000;
    margin-bottom: 0;
    position: relative;
    display: inline-block;
  }

  .video-sleeve-subtitle3::after {
    content: "";
    display: block;
    width: 40px;
    height: 1px;
    background-color: #333;
    margin: 3px auto 0;
  }

  .video-sleeve-title3 {
    font-family: 'PoppinsExtraBold', sans-serif;
    font-size: 20px;
    line-height: 1.3;
    text-transform: uppercase;
    color: #000;
    margin-top: 5px;
     margin-bottom: 20px;
  }

  .video-sleeve-caption3 {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-top: 2px;
    font-family: 'PoppinsLight', sans-serif;
    font-size: 11px;
    color: #000;
    margin-bottom: 20px;
  }

  .video-sleeve-caption3 img {
    height: 10px;
    margin-right: 6px;
  }

  /* GRID 2x2 SEM SCROLL */
  .video-sleeve-grid3 {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 16px 10px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 20px;
    row-gap: 24px;
    justify-items: center;
  }

  .video-sleeve-card3 {
    width: 100%;
    max-width: 420px;
    box-sizing: border-box;
    background: #ffffff;
    border: 1px solid #000;
    border-radius: 16px;
    overflow: hidden;
  }

  .video-sleeve-photo3 {
    width: 100%;
    display: block;
    /* garante proporção “story” / vertical */
    aspect-ratio: 9 / 16;
    object-fit: cover;
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
  }

  @media (max-width: 480px) {
    .video-sleeve-grid3 {
      padding: 0 10px 10px;
      column-gap: 12px;
      row-gap: 16px;
    }
  }

  /* Modificação para Desktop (4 vídeos em uma linha) */
  @media (min-width: 1024px) {
    .video-sleeve-grid3 {
      grid-template-columns: repeat(4, 1fr); /* 4 colunas em telas grandes */
    }
  }
</style>

<section class="video-sleeve-carousel-wrapper3">
  <div style="text-align:center;margin-bottom:1.5rem;padding-top:0rem;">
    <!-- Usando a chave de tradução do locals -->
    <div class="video-sleeve-subtitle3">
      {{ 'sleeve-video.subtitle' | t }}
    </div>
    <div class="video-sleeve-title3">
      {{ 'sleeve-video.title' | t }}
    </div>
  </div>

  <div class="video-sleeve-grid3">
    <!-- Vídeo 1 -->
    <div class="video-sleeve-card3">
<video class="video-sleeve-photo3" controls playsinline preload="auto"
       poster="https://cdn.shopify.com/s/files/1/0907/8472/7374/files/Timeline_2_frame_0_00_0f.jpg?v=1763240879">
  <source src="https://cdn.shopify.com/videos/c/o/v/8a336913a6fc48669390890463e6661d.mp4" type="video/mp4">
</video>
    </div>

    <!-- Vídeo 2 -->
    <div class="video-sleeve-card3">
<video class="video-sleeve-photo3" controls playsinline preload="auto"
       poster="https://cdn.shopify.com/s/files/1/0907/8472/7374/files/Semedo_Final_frame_0_00_0f.jpg?v=1763240880">
  <source src="https://cdn.shopify.com/videos/c/o/v/c0adccb220d8465aacf903dbb019b39b.mp4" type="video/mp4">
</video>
    </div>

    <!-- Vídeo 3 -->
    <div class="video-sleeve-card3">
<video class="video-sleeve-photo3" controls playsinline preload="auto"
       poster="https://cdn.shopify.com/s/files/1/0907/8472/7374/files/Stop_Espanhol_Final_frame_0_00_0f.jpg?v=1763240880">
  <source src="https://cdn.shopify.com/videos/c/o/v/4a4d1c21440c42ffb73d5c49f9b91a99.mp4" type="video/mp4">
</video>
    </div>

    <!-- Vídeo 4 -->
    <div class="video-sleeve-card3">
<video class="video-sleeve-photo3" controls playsinline preload="auto"
       poster="https://cdn.shopify.com/s/files/1/0907/8472/7374/files/If_you_Look_Good_1__frame_0_00_0f.jpg?v=1763240881">
  <source src="https://cdn.shopify.com/videos/c/o/v/7dd1e98d7fc04173a9f67e2a62595bd7.mp4" type="video/mp4">
</video>
    </div>
  </div>
</section>
