<!-- FONTES -->
<style>
  @font-face {
    font-family: 'Poppins';
    src: url('https://cdn.shopify.com/s/files/1/0907/8472/7374/files/poppins.medium.ttf?v=1747688794') format('truetype');
    font-weight: normal;
    font-style: normal;
  }

  .footer-text,
  .footer-title,
  .footer-links-container strong,
  .footer-links-container ul,
  .footer-links-container li,
  .footer-links-container a,
  .accordion-title,
  .accordion-content a,
  .copyright,
  .payment-icons,
  .payment-icons img {
    font-family: 'Poppins' !important;
  }

  .footer-section {
    background: url('https://cdn.shopify.com/s/files/1/0907/8472/7374/files/Design_sem_nome_2_e08388e1-b3ae-45df-a74d-b633c80360c1.png?v=1748260209') no-repeat center center / cover;
    color: white;
    margin: 0;
    padding: 0;
  }

  .footer-wrapper {
    max-width: 1200px;
    margin: auto;
    text-align: left;
    padding: 80px 20px 20px 20px;
  }

  .footer-text {
    max-width: 500px;
    font-size: 14px;
    line-height: 1.6;
    margin: 0 auto 20px auto;
    color: white;
    font-family: 'Poppins' !important;
  }

  .footer-links-container {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2rem;
    color: white;
  }

  .footer-links-container strong {
    display: block;
    margin-bottom: 10px;
  }

  .footer-links-container ul {
    list-style: none;
    padding: 0;
    font-size: 14px;
    margin: 0;
  }

  .footer-links-container li {
    margin-bottom: 5px;
  }

  .footer-links-container a {
    color: white !important;
    text-decoration: none !important;
    font-family: 'Poppins' !important;
  }

  .footer-links-container a:hover {
    opacity: 0.8;
  }

  .accordion-title {
    display: none;
    border-top: 1px solid #fff;
    padding: 15px 0;
    cursor: pointer;
    font-weight: bold;
  }

  .accordion-title:after {
    content: '+';
    float: right;
  }

  .accordion-title.active:after {
    content: '-';
  }

  .accordion-content {
    display: none;
    padding: 0 0 15px 0;
  }

  .accordion-content a {
    color: white !important;
    text-decoration: none !important;
    font-family: 'Poppins' !important;
  }

  .copyright {
    font-size: 12px;
    color: white;
    text-align: center;
    margin-top: 2rem;
    font-family: 'Poppins' !important;
  }

  .payment-shipping-strip {
    text-align: center;
    margin-top: 30px;
  }

  .payment-icons {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0px;
    margin-top: 20px;
    margin-bottom: 20px;
  }

  .payment-icons img {
    height: 30px;
    object-fit: contain;
  }

  hr.custom-hr {
    border: none;
    border-top: 0.5px solid white;
    margin: 2rem 0;
  }

  @media (max-width: 768px) {
    .footer-links-container {
      display: none;
    }

    .accordion-title {
      display: block;
    }

    hr.custom-hr {
      display: none;
    }
  }

  @media (min-width: 769px) {
    .footer-title {
      font-size: 35px !important;
      text-align: center !important;
      text-transform: uppercase !important;
      margin: 0 auto 20px auto !important;
    }

    .footer-text {
      font-size: 20px !important;
      text-align: center !important;
      max-width: 1200px !important;
      margin: 0 auto 40px auto !important;
      padding-left: 80px !important;
      padding-right: 80px !important;
    }

    .footer-links-container {
      justify-content: center !important;
      gap: 6rem !important;
      font-size: 18px !important;
    }

    .footer-links-container > div {
      margin-left: 150px !important;
    }

    .footer-links-container strong {
      font-size: 18px !important;
      display: block;
      margin-bottom: 10px;
    }

    .footer-links-container ul {
      font-size: 18px !important;
      margin: 0 !important;
      padding-left: 0 !important;
    }

    .footer-links-container li {
      margin-bottom: 12px !important;
      padding-left: 0 !important;
    }

    .footer-section a img[alt="Instagram"],
    .footer-section a img[alt="TikTok"],
    .footer-section a img[alt="Facebook"],
    .footer-section a img[alt="YouTube"] {
      width: 50px !important;
      height: auto !important;
    }

    .footer-wrapper > div:first-child img {
      max-width: 150px !important;
    }

    .payment-icons img {
      height: 36px !important;
      object-fit: contain;
    }

    .copyright {
      font-size: 16px !important;
      margin-top: 50px;
    }

    hr.custom-hr {
      display: block !important;
      border-top: 1px solid white !important;
      margin-top: 30px !important;
      margin-bottom: 40px !important;
    }
  }

  .footer-custom-payment-icons {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 7px;
}

.footer-custom-payment-icons .cartao-carrinho-item img {
  height: 30px;
  object-fit: contain;
}


  @media (max-width: 768px) {
    .footer-title {
      text-align: center !important;
      font-size: 18px !important;
      text-transform: uppercase !important;
      margin-bottom: 8px !important;
    }

    .footer-text {
      text-align: center !important;
      font-size: 12px !important;
      padding-left: 15px !important;
      padding-right: 15px !important;
    }
  }
</style>

