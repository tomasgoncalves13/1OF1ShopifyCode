{%- liquid
  assign uid = section.id | replace: '_', '-'
-%}

<div class="video-unboxing-1of1-wrap oneofone-tu oneofone-tu--{{ uid }}">
  <div class="oneofone-tu__inner">

    <div class="oneofone-tu__img-col">
      <video
        class="oneofone-tu__video"
        id="oneofone-tu-vid-{{ uid }}"
        src="https://cdn.shopify.com/videos/c/o/v/5112af9b7c534d689b6fb20e248f38ae.mp4"
        muted
        playsinline
        loop
        preload="metadata"
        aria-hidden="true"
      ></video>
    </div>

    <div class="oneofone-tu__text-col">
      <div class="oneofone-tu__copy">
        <h2 class="oneofone-tu__section-title video-unboxing-1of1-heading">EXPERIÊNCIA 1OF1</h2>
        <span class="oneofone-tu__overline">Equipa-te como um profissional</span>
      </div>

      <div class="oneofone-tu__cta video-unboxing-1of1-atc-wrap">
        <button
          type="button"
          class="oneofone-tu__btn video-unboxing-1of1-atc-btn"
          data-variant-id="55735470129527"
        >
          50% DESCONTO ⭢
        </button>
      </div>
    </div>

  </div>
</div>

<style>
  @font-face { font-family: 'PoppinsExtraBold'; src: url('https://cdn.shopify.com/s/files/1/0907/8472/7374/files/poppins.extrabold.ttf?v=1747688794') format('truetype'); }
  @font-face { font-family: 'PoppinsBold';      src: url('https://cdn.shopify.com/s/files/1/0907/8472/7374/files/poppins.bold.ttf?v=1747688795') format('truetype'); }
  @font-face { font-family: 'PoppinsSemiBold';  src: url('https://cdn.shopify.com/s/files/1/0907/8472/7374/files/poppins.semibold.ttf?v=1747688794') format('truetype'); }
  @font-face { font-family: 'PoppinsMedium';    src: url('https://cdn.shopify.com/s/files/1/0907/8472/7374/files/poppins.medium.ttf?v=1747688794') format('truetype'); }
  @font-face { font-family: 'PoppinsLight';     src: url('https://cdn.shopify.com/s/files/1/0907/8472/7374/files/poppins.light.ttf?v=1748130416') format('truetype'); }
  @font-face { font-family: 'MontserratExtraBold'; src: url('https://cdn.shopify.com/s/files/1/0907/8472/7374/files/Montserrat-ExtraBold.ttf?v=1775402219') format('truetype'); font-display: swap; }
  @font-face { font-family: 'MontserratBold';      src: url('https://cdn.shopify.com/s/files/1/0907/8472/7374/files/Montserrat-Bold.ttf?v=1775402219') format('truetype'); font-display: swap; }
  @font-face { font-family: 'MontserratSemiBold';  src: url('https://cdn.shopify.com/s/files/1/0907/8472/7374/files/Montserrat-SemiBold.ttf?v=1775402091') format('truetype'); font-display: swap; }
  @font-face { font-family: 'MontserratMedium';    src: url('https://cdn.shopify.com/s/files/1/0907/8472/7374/files/Montserrat-Medium.ttf?v=1775402219') format('truetype'); font-display: swap; }
  @font-face { font-family: 'Montserratregular';   src: url('https://cdn.shopify.com/s/files/1/0907/8472/7374/files/Montserrat-Regular.ttf?v=1775402219') format('truetype'); font-display: swap; }

  .oneofone-tu--{{ uid }} {
    background: #fff;
    font-family: 'Montserratregular', sans-serif;
    -webkit-font-smoothing: antialiased;
    padding: 12px 16px 24px;
    text-align: left;
  }

  .oneofone-tu--{{ uid }} .oneofone-tu__inner {
    max-width: 860px;
    margin: 0 auto;
    display: flex;
    align-items: stretch;
    gap: 0;
    border: 1.5px solid #edeae5;
    border-radius: 16px;
    overflow: hidden;
    background: #fff;
  }

  .oneofone-tu--{{ uid }} .oneofone-tu__img-col {
    flex: 0 0 50%;
    position: relative;
    overflow: hidden;
    background: #f4f4f2;
    aspect-ratio: 5 / 6;
  }

  .oneofone-tu--{{ uid }} .oneofone-tu__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform .6s cubic-bezier(.4,0,.2,1);
  }

  .oneofone-tu--{{ uid }} .oneofone-tu__inner:hover .oneofone-tu__video {
    transform: scale(1.03);
  }

  .oneofone-tu--{{ uid }} .oneofone-tu__text-col {
    flex: 1;
    padding: 28px 26px;
    border-left: 1.5px solid #edeae5;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    text-align: left;
  }

  .oneofone-tu--{{ uid }} .oneofone-tu__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    flex: 1;
    min-width: 0;
  }

  .oneofone-tu--{{ uid }} .oneofone-tu__section-title {
    font-family: 'PoppinsExtraBold', sans-serif !important;
    font-weight: 800 !important;
    font-size: clamp(20px, 3vw, 28px) !important;
    color: #111 !important;
    margin: 0 0 8px !important;
    line-height: 1.15 !important;
    letter-spacing: 0.5px !important;
    text-align: left !important;
    padding: 0 !important;
  }

  .oneofone-tu--{{ uid }} .oneofone-tu__overline {
    display: block;
    font-family: 'MontserratBold', sans-serif;
    font-size: 16px;
    text-transform: uppercase;
    color: #4f92c7;
    margin: 0;
  }

  .oneofone-tu--{{ uid }} .oneofone-tu__cta {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    margin: 0 !important;
    justify-content: flex-end !important;
  }

  .oneofone-tu--{{ uid }} .oneofone-tu__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 26px;
    border-radius: 10px;
    border: none;
    cursor: pointer;
    font-family: 'PoppinsBold', sans-serif;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    text-decoration: none;
    color: #fff;
    background: linear-gradient(90deg, #4f92c7, #38beef);
    position: relative;
    overflow: hidden;
    transition: transform .18s cubic-bezier(.34,1.56,.64,1), box-shadow .2s ease;
    -webkit-tap-highlight-color: transparent;
    animation: none;
    white-space: nowrap;
  }

  .oneofone-tu--{{ uid }} .oneofone-tu__btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(79,146,199,0.4);
  }

  .oneofone-tu--{{ uid }} .oneofone-tu__btn:active {
    transform: translateY(0);
  }

  .oneofone-tu--{{ uid }} .oneofone-tu__btn::after {
    content: '';
    position: absolute;
    top: 0; bottom: 0; left: 0;
    width: 55%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,.22), transparent);
    transform: translateX(-120%);
    animation: oneofone-tu-shimmer-{{ uid }} 2.4s ease-in-out infinite;
    pointer-events: none;
  }

  @keyframes oneofone-tu-shimmer-{{ uid }} {
    0%   { transform: translateX(-120%); }
    100% { transform: translateX(280%); }
  }

  @media (max-width: 749px) {
    .oneofone-tu--{{ uid }} {
      padding: 8px 12px 16px;
    }
    .oneofone-tu--{{ uid }} .oneofone-tu__section-title {
      font-size: 18px !important;
      margin: 0 0 6px !important;
      text-align: left !important;
    }
    .oneofone-tu--{{ uid }} .oneofone-tu__inner {
      flex-direction: column;
    }
    .oneofone-tu--{{ uid }} .oneofone-tu__img-col {
      flex: none;
      width: 100%;
      aspect-ratio: 5 / 6;
    }
    .oneofone-tu--{{ uid }} .oneofone-tu__text-col {
      border-left: none;
      border-top: 1.5px solid #edeae5;
      padding: 18px 16px;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      width: 100%;
      box-sizing: border-box;
    }
    .oneofone-tu--{{ uid }} .oneofone-tu__overline {
      font-size: 13px;
    }
    .oneofone-tu--{{ uid }} .oneofone-tu__btn {
      padding: 12px 18px;
      font-size: 13px;
      letter-spacing: 1px;
    }
  }

  @media (min-width: 1024px) {
    .oneofone-tu--{{ uid }} {
      padding: 40px 0;
    }
    .oneofone-tu--{{ uid }} .oneofone-tu__section-title {
      font-size: 32px !important;
      margin: 0 0 10px !important;
      text-align: left !important;
    }
    .oneofone-tu--{{ uid }} .oneofone-tu__text-col {
      padding: 36px 32px;
    }
    .oneofone-tu--{{ uid }} .oneofone-tu__overline {
      font-size: 18px;
    }
    .oneofone-tu--{{ uid }} .oneofone-tu__btn {
      font-size: 17px;
      padding: 16px 32px;
    }
  }
</style>

<script>
  (function () {
    var root = document.querySelector('.oneofone-tu--{{ uid }}');
    if (!root || root.dataset.oneofoneTuReady === '1') return;
    root.dataset.oneofoneTuReady = '1';

    var vid = document.getElementById('oneofone-tu-vid-{{ uid }}');
    if (vid) {
      var io = new IntersectionObserver(function (entries, obs) {
        if (entries[0].isIntersecting) {
          vid.play().catch(function () {});
          obs.disconnect();
        }
      }, { rootMargin: '100px' });
      io.observe(vid);
    }

    var btn = root.querySelector('.oneofone-tu__btn');
    if (!btn) return;

    btn.addEventListener('click', async function () {
      var variantId = btn.dataset.variantId;
      try {
        var res = await fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: Number(variantId), quantity: 1 })
        });
        if (!res.ok) throw new Error();

        var cartRes = await fetch('/cart/update.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            updates: {},
            sections: ['cart-drawer', 'cart-icon-bubble']
          })
        });

        var cartData = await cartRes.json();
        var drawer = document.querySelector('cart-drawer');

        if (drawer && typeof drawer.renderContents === 'function') {
          drawer.renderContents(cartData);
          drawer.classList.remove('is-empty');
        } else {
          window.location.href = '/cart';
        }
      } catch (e) {
        alert('Erro ao adicionar ao carrinho');
      }
    });
  })();
</script>
