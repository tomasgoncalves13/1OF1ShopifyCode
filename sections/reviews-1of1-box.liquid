<style>
@font-face {
  font-family: 'PoppinsRegular';
  src: url('https://cdn.shopify.com/s/files/1/0907/8472/7374/files/Poppins-Regular.ttf?v=1753909133') format('truetype');
}

@font-face {
  font-family: 'PoppinsMedium';
  src: url('https://cdn.shopify.com/s/files/1/0907/8472/7374/files/poppins.medium.ttf?v=1747688794') format('truetype');
}

@font-face {
  font-family: 'PoppinsLight';
  src: url('https://cdn.shopify.com/s/files/1/0907/8472/7374/files/poppins.light.ttf?v=1748130416') format('truetype');
}

/* ===== REVIEWS 1OF1 BOX (ISOLADO) ===== */
.reviews-1of1-box {
  padding: 5px 10px 0px 10px;
  box-sizing: border-box;
}

.reviews-1of1-box * {
  box-sizing: border-box;
}

.reviews-1of1-box__container {
  position: relative;
  max-width: 1000px;
  margin: 0 auto;
  padding: 0px 10px 0px 10px;
}

.reviews-1of1-box__headline h2 {
  text-align: center;
  font-family: 'PoppinsRegular', sans-serif;
  font-size: 22px;
  margin-bottom: 25px;
}

.reviews-1of1-box__grid {
  column-count: 2;
  column-gap: 20px;
}

.reviews-1of1-box__item {
  display: inline-block;
  width: 100%;
  margin-bottom: 12px;
}

.reviews-1of1-box__item {
  position: relative;
  border-radius: 5px;
  box-shadow: 0 0 5px rgba(0, 0, 0, 0.20);
  padding: 0 0 60px 0;
  background: #ffffff;
  overflow: hidden;
}

.reviews-1of1-box__item > img {
  width: 100%;
  display: block;
}

.reviews-1of1-box__stars {
  margin: 7px 0px 0px 10px;
}

.reviews-1of1-box__stars g {
  fill: #00b67a;
}

.reviews-1of1-box__item p {
  padding: 0 12px;
  font-family: 'PoppinsMedium', sans-serif;
  font-size: 14px;
  line-height: 1.4;
  margin-bottom: 5px;
  margin-top: 5px;
}

.reviews-1of1-box__author {
  position: absolute;
  bottom: 10px;
  left: 12px;
  display: grid;
  grid-template-columns: 40px 1fr;
  gap: 10px;
  align-items: center;
  font-family: 'PoppinsRegular', sans-serif;
}

.reviews-1of1-box__author img {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  object-fit: cover;
}

.reviews-1of1-box__author div {
  line-height: 1.2;
  margin: 0;
  padding-right: 15px;
  font-size: 13px;
  font-family: 'PoppinsRegular', sans-serif;
}

/* MOBILE */
@media (max-width: 800px) {
  .reviews-1of1-box {
            padding: 5px 10px 0px 10px;

  }

  .reviews-1of1-box__container {
        padding: 0px 10px 0px 10px;
  }

  .reviews-1of1-box__grid {
    grid-template-columns: 1fr 1fr;
    gap: 15px;
  }

  .reviews-1of1-box__item p {
    font-size: 13px;
  }
}
</style>
