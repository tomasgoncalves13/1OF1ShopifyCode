<script>
function formatSectionTrackingDate(date) {
  let day = date.getDate();
  let month = date.getMonth() + 1;
  if(day < 10) day = '0' + day;
  if(month < 10) month = '0' + month;
  return `${day}/${month}`;
}

function nextSectionTrackingBusinessDay(date, addDays = 1) {
  let result = new Date(date);
  let added = 0;
  while(added < addDays) {
    result.setDate(result.getDate() + 1);
    let day = result.getDay();
    if(day !== 0 && day !== 6) added++;
  }
  return result;
}

