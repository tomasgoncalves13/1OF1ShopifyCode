{%- liquid
  assign uid = section.id | replace: '_', '-'
-%}

<div class="oneofone-trustpills-wrap" style="margin: {{ section.settings.margin_top }}px {{ section.settings.margin_horizontal }}px {{ section.settings.margin_bottom }}px; padding: {{ section.settings.padding_top }}px {{ section.settings.padding_horizontal }}px {{ section.settings.padding_bottom }}px;">
  <div class="oneofone-tp" id="oneofone-tp-{{ uid }}" data-oneofone-tp>

    <div class="oneofone-tp__row">
      {%- for block in section.blocks -%}
        {%- if forloop.index0 > 0 -%}
          <div class="oneofone-tp__sep" aria-hidden="true"></div>
        {%- endif -%}
        <button type="button" class="oneofone-tp__item" data-oneofone-tp-idx="{{ forloop.index0 }}" aria-expanded="false" aria-controls="oneofone-tp-panel-{{ uid }}">
          <div class="oneofone-tp__icon">
            {%- case block.settings.icon_type -%}
              {%- when 'shield' -%}
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 2L3 7v5c0 5.25 3.75 10.15 9 11.35C17.25 22.15 21 17.25 21 12V7l-9-5z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"></path></svg>
              {%- when 'pin' -%}
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 22s-8-5-8-12a8 8 0 0116 0c0 7-8 12-8 12z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"></path><path d="M9 11l2 2 4-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path></svg>
              {%- when 'ctt' -%}
                <img src="https://cdn.shopify.com/s/files/1/0907/8472/7374/files/1_c6b9f526-4b73-4bbb-b775-fdf05f6785da.png?v=1765667649" alt="CTT" class="oneofone-tp__img" width="22" height="22" loading="lazy" decoding="async">
              {%- when 'truck' -%}
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"></path><circle cx="7" cy="18" r="1.7" stroke="currentColor" stroke-width="1.5"></circle><circle cx="17" cy="18" r="1.7" stroke="currentColor" stroke-width="1.5"></circle></svg>
              {%- when 'star' -%}
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3l2.6 5.6 6.1.7-4.5 4.2 1.2 6-5.4-3-5.4 3 1.2-6L3.3 9.3l6.1-.7L12 3z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"></path></svg>
              {%- when 'image' -%}
                {%- if block.settings.icon_image != blank -%}
                  <img src="{{ block.settings.icon_image | image_url: width: 88 }}" alt="{{ block.settings.label | escape }}" class="oneofone-tp__img" width="22" height="22" loading="lazy" decoding="async">
                {%- endif -%}
            {%- endcase -%}
          </div>
          <span class="oneofone-tp__label">{{ block.settings.label }}</span>
          <svg class="oneofone-tp__arr" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2 4.5l4 4 4-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </button>
      {%- endfor -%}
    </div>

    <div class="oneofone-tp__panel" id="oneofone-tp-panel-{{ uid }}" aria-hidden="true">
      <div class="oneofone-tp__panel-inner">
        <div class="oneofone-tp__panel-body" data-oneofone-tp-body></div>
      </div>
    </div>

  </div>
</div>

<style>
  #oneofone-tp-{{ uid }} {
    border: 1px solid {{ section.settings.border_color }};
    border-radius: 14px;
    background: {{ section.settings.bg_color }};
    overflow: hidden;
    font-family: var(--font-body-family, sans-serif);
  }
  #oneofone-tp-{{ uid }} .oneofone-tp__row { display: flex; align-items: stretch; }
  #oneofone-tp-{{ uid }} .oneofone-tp__sep { width: 1px; background: {{ section.settings.border_color }}; flex-shrink: 0; margin: 10px 0; }
  #oneofone-tp-{{ uid }} .oneofone-tp__item {
    flex: 1; display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    gap: 6px; padding: 14px 8px 12px;
    background: none; border: none; cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: background .18s ease; position: relative;
  }
  #oneofone-tp-{{ uid }} .oneofone-tp__item:hover { background: {{ section.settings.accent_color }}0d; }
  #oneofone-tp-{{ uid }} .oneofone-tp__item.is-active { background: {{ section.settings.accent_color }}14; }
  #oneofone-tp-{{ uid }} .oneofone-tp__item::after {
    content: ''; position: absolute;
    bottom: 0; left: 20%; right: 20%;
    height: 2px; background: {{ section.settings.accent_color }};
    border-radius: 2px 2px 0 0;
    transform: scaleX(0); transition: transform .22s ease;
  }
  #oneofone-tp-{{ uid }} .oneofone-tp__item.is-active::after { transform: scaleX(1); }
  #oneofone-tp-{{ uid }} .oneofone-tp__icon {
    width: 34px; height: 34px; border-radius: 10px;
    background: #fff; border: 1px solid {{ section.settings.border_color }};
    display: grid; place-items: center;
    transition: background .2s, border-color .2s;
  }
  #oneofone-tp-{{ uid }} .oneofone-tp__icon svg { width: 16px; height: 16px; stroke: #999; transition: stroke .2s; }
  #oneofone-tp-{{ uid }} .oneofone-tp__img { width: 22px; height: auto; object-fit: contain; display: block; }
  #oneofone-tp-{{ uid }} .oneofone-tp__item.is-active .oneofone-tp__icon { background: #000000; border-color: #000000; color: #fff; }
  #oneofone-tp-{{ uid }} .oneofone-tp__item.is-active .oneofone-tp__icon svg { stroke: #fff; }
  #oneofone-tp-{{ uid }} .oneofone-tp__item.is-active .oneofone-tp__img { filter: brightness(0) invert(1); }
  #oneofone-tp-{{ uid }} .oneofone-tp__label {
    font-size: 10px; font-weight: 700; color: {{ section.settings.label_color }};
    letter-spacing: 0.03em; text-transform: uppercase;
    text-align: center; line-height: 1.3; transition: color .2s;
  }
  #oneofone-tp-{{ uid }} .oneofone-tp__item.is-active .oneofone-tp__label { color: {{ section.settings.accent_color }}; }
  #oneofone-tp-{{ uid }} .oneofone-tp__arr { width: 12px; height: 12px; color: #ccc; transition: transform .22s ease, color .2s; }
  #oneofone-tp-{{ uid }} .oneofone-tp__item.is-active .oneofone-tp__arr { transform: rotate(180deg); color: {{ section.settings.accent_color }}; }
  #oneofone-tp-{{ uid }} .oneofone-tp__panel {
    display: grid; grid-template-rows: 0fr;
    transition: grid-template-rows .28s ease;
    border-top: 1px solid transparent;
  }
  #oneofone-tp-{{ uid }} .oneofone-tp__panel.is-open { grid-template-rows: 1fr; border-top-color: {{ section.settings.border_color }}; }
  #oneofone-tp-{{ uid }} .oneofone-tp__panel-inner { overflow: hidden; }
  #oneofone-tp-{{ uid }} .oneofone-tp__panel-body {
    padding: 12px 16px 14px;
    font-size: 12px; font-weight: 400; color: {{ section.settings.body_color }}; line-height: 1.65;
  }
</style>

<script>
  (function () {
    var root = document.getElementById('oneofone-tp-{{ uid }}');
    if (!root || root.dataset.oneofoneTpReady === '1') return;
    root.dataset.oneofoneTpReady = '1';

    var items = Array.from(root.querySelectorAll('.oneofone-tp__item'));
    var panel = root.querySelector('.oneofone-tp__panel');
    var body  = root.querySelector('[data-oneofone-tp-body]');
    var texts = {{ section.blocks | map: 'settings' | map: 'description' | json }};
    var current = -1;

    items.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var idx = parseInt(btn.getAttribute('data-oneofone-tp-idx'), 10);

        if (current === idx) {
          btn.classList.remove('is-active');
          btn.setAttribute('aria-expanded', 'false');
          panel.classList.remove('is-open');
          panel.setAttribute('aria-hidden', 'true');
          current = -1;
          return;
        }

        items.forEach(function (b) {
          b.classList.remove('is-active');
          b.setAttribute('aria-expanded', 'false');
        });

        btn.classList.add('is-active');
        btn.setAttribute('aria-expanded', 'true');
        body.textContent = texts[idx] || '';
        panel.classList.add('is-open');
        panel.setAttribute('aria-hidden', 'false');
        current = idx;
      });
    });
  })();
</script>

{% schema %}
{
  "name": "1of1 Trust Pills",
  "tag": "section",
  "class": "section-1of1-trust-pills",
  "settings": [
    {
      "type": "header",
      "content": "Cores"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Fundo",
      "default": "#f7f7f7"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Bordas / separadores",
      "default": "#edeae5"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Cor de destaque",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Cor do rótulo",
      "default": "#555555"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Cor do texto descritivo",
      "default": "#555555"
    },
    {
      "type": "header",
      "content": "Espaçamento"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margem topo",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margem fundo",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "margin_horizontal",
      "label": "Margem lateral",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding topo",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding fundo",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Padding lateral",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "pill",
      "name": "Pilar",
      "limit": 5,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Rótulo (curto)",
          "default": "Garantia 3 Anos"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Descrição (mostrada ao clicar)",
          "default": "Todos os produtos 1OF1 têm garantia de 3 anos contra defeitos de fabrico. Se algo não estiver bem, tratamos do assunto."
        },
        {
          "type": "select",
          "id": "icon_type",
          "label": "Ícone",
          "options": [
            { "value": "shield", "label": "Escudo (garantia)" },
            { "value": "ctt",    "label": "CTT (logo)" },
            { "value": "truck",  "label": "Camião (envio)" },
            { "value": "pin",    "label": "Pin (verificado)" },
            { "value": "star",   "label": "Estrela" },
            { "value": "image",  "label": "Imagem personalizada" }
          ],
          "default": "shield"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Imagem do ícone (apenas se ícone = Imagem)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "1of1 Trust Pills",
      "blocks": [
        {
          "type": "pill",
          "settings": {
            "label": "Garantia 3 Anos",
            "description": "Todos os produtos 1OF1 têm garantia de 3 anos contra defeitos de fabrico. Se algo não estiver bem, tratamos do assunto.",
            "icon_type": "shield"
          }
        },
        {
          "type": "pill",
          "settings": {
            "label": "Envio Grátis CTT",
            "description": "Enviamos por CTT Expresso. A encomenda sai no dia útil seguinte e chega entre 3 a 5 dias. Recebes informações de rastreio por email.",
            "icon_type": "ctt"
          }
        },
        {
          "type": "pill",
          "settings": {
            "label": "Testa 30 Dias",
            "description": "Tens 30 dias para experimentar. Se não ficares satisfeito, devolves e reembolsamos o valor do produto. Sem complicações.",
            "icon_type": "pin"
          }
        }
      ]
    }
  ]
}
{% endschema %}
