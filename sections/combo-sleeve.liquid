{% assign shin = all_products["shin-pad-sleeve"] %}
{% assign grip = all_products["grip-socks"] %}  <!-- Confirma que este handle corresponde ao link enviado -->

{% if shin and grip %}
<section class="combo-sleeve-card">
  <h2 class="combo-sleeve-title">
    Combo <span class="bf-gradient">de Natal</span>
  </h2>
  <p class="combo-sleeve-sub">
    15% EXTRA e proteção completa.
  </p>

  <div class="combo-sleeve-products">
    <!-- ESQUERDA — SHIN PAD SLEEVE -->
    <div class="combo-item">
      <div class="combo-image-wrap">
        <a href="{{ shin.url }}">
          <img src="{{ shin.featured_image | image_url: width: 400 }}" alt="{{ shin.title }}">
        </a>
      </div>
      <p class="combo-prices">
        {% if shin.compare_at_price > shin.price %}
          <span class="compare">{{ shin.compare_at_price | money }}</span>
        {% endif %}
        <span class="actual">{{ shin.price | money }}</span>
      </p>
    </div>

    <div class="combo-plus">+</div>

    <!-- DIREITA — GRIP SOCKS -->
    <div class="combo-item">
      <div class="combo-image-wrap">
        <a href="{{ grip.url }}">
          <img src="{{ grip.featured_image | image_url: width: 400 }}" alt="{{ grip.title }}">
        </a>
      </div>
      <p class="combo-prices">
        {% if grip.compare_at_price > grip.price %}
          <span class="compare">{{ grip.compare_at_price | money }}</span>
        {% endif %}
        <span class="actual">{{ grip.price | money }}</span>
      </p>
    </div>
  </div>

  {% assign total_compare = shin.compare_at_price | plus: grip.compare_at_price %}
  {% assign total_price = shin.price | plus: grip.price %}
  {% assign total_final = total_price | times: 0.85 %}

  <div class="combo-sleeve-total">
    <span class="label">Total:</span>
    <span class="total-compare">{{ total_compare | money }}</span>
    <span class="total-final">{{ total_final | money }}</span>
    <span class="bundle-badge">
      <svg class="badge-icon" viewBox="0 0 12 12">
        <path fill="white" fill-rule="evenodd" d="M7 0h3a2 2 0 0 1 2 2v3a1 1 0 0 1-.3.7l-6 6a1 1 0 0 1-1.4 0l-4-4a1 1 0 0 1 0-1.4l6-6A1 1 0 0 1 7 0m2 2a1 1 0 1 0 2 0 1 1 0 0 0-2 0" clip-rule="evenodd"></path>
      </svg>
      15% EXTRA
    </span>
  </div>

  <form method="post" action="/cart/add" class="combo-sleeve-form">
    <input type="hidden" name="items[0][id]" value="{{ shin.first_available_variant.id }}">
    <input type="hidden" name="items[0][quantity]" value="1">

    <input type="hidden" name="items[1][id]" value="{{ grip.first_available_variant.id }}">
    <input type="hidden" name="items[1][quantity]" value="1">

    <input type="hidden" name="return_to" value="/checkout?discount=BUNDLE15">

    <button type="submit" class="combo-sleeve-button">
      APROVEITAR
    </button>
  </form>
</section>

<style>
@font-face {
  font-family: 'PoppinsRegular';
  src: url('https://cdn.shopify.com/s/files/1/0907/8472/7374/files/Poppins-Regular.ttf?v=1753909133') format('truetype');
}

@font-face {
  font-family: 'PoppinsSemiBold';
  src: url('https://cdn.shopify.com/s/files/1/0907/8472/7374/files/poppins.semibold.ttf?v=1747688794') format('truetype');
}

@font-face {
  font-family: 'PoppinsMedium';
  src: url('https://cdn.shopify.com/s/files/1/0907/8472/7374/files/poppins.medium.ttf?v=1747688794') format('truetype');
}

.combo-sleeve-card { 
  background: #fff;
  border-radius: 10px;
  padding: 0 22px 22px;
  box-shadow: 0 8px 22px rgba(0, 0, 0, 0.06);
  max-width: 380px;
  margin: 0px 15px 25px 15px;
  text-align: center;
  border: none;
  font-family: 'PoppinsRegular', sans-serif;
}

.combo-sleeve-title {
  font-size: 18px;
  margin-bottom: 4px;
  padding-top: 16px;
  margin-top: 0px;
}

.bf-gradient {
  background: linear-gradient(135deg, #7a0000 0%, #b30000 45%, #d10000 75%, #ff0000 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.combo-sleeve-sub {
  font-size: 12px;
  line-height: 1.2;
  font-family: 'PoppinsMedium', sans-serif;
  color: #555;
  margin-bottom: 12px;
  white-space: nowrap;
  text-align: center; /* 👈 centrado */
}


.combo-sleeve-products {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
}

.combo-item {
  background: #f6f6f6;
  border-radius: 7px;
  padding: 10px 9px;
  text-align: center;
}

.combo-item img {
  max-width: 100%;
}

.compare {
  text-decoration: line-through;
  opacity: .6;
  color: #333;
  font-size: 12px;
}

.actual {
  color: #7a0000;
  font-weight: 500;
  font-size: 13px;
}

.combo-plus {
  font-size: 30px;
  font-weight: 700;
  color: #ff0000;
}

.combo-sleeve-total {
  font-size: 13.5px;
  display: flex;
  gap: 6px;
  justify-content: center;
  align-items: center;
  margin-top: 10px;
  margin-bottom: 15px;
}

.combo-sleeve-total .label {
  font-weight: normal; 
  margin-right: 4px;
}

.total-compare {
  font-family: 'PoppinsMedium', sans-serif;
  color: #333;
  opacity: .6;
  text-decoration: line-through;
}

.total-final {
  font-family: 'PoppinsSemiBold', sans-serif;
  color: #b30000 !important;
}

.bundle-badge {
  background: #7a0000;
  color: #ffba3a;
  font-size: 10px;
  padding: 3px 10px;
  border-radius: 4px;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-weight: 600;
  border: 1px solid #b30000;
}

.badge-icon {
  width: 10px;
  height: 10px;
  display: inline-block;
  flex-shrink: 0;
}

.combo-sleeve-button {
  width: 100%;
  padding: 12px 16px;
  border: none;
  background: linear-gradient(135deg, #7a0000 25%, #b30000 55%, #ff0000 100%);
  color: #ffffff;
  font-size: 13.5px;
  border-radius: 6px;
  cursor: pointer;
  animation: combo-sleeve-pulse-natal 1.6s ease-in-out infinite;
}

@media (min-width: 769px) {
  .combo-sleeve-card {
    width: calc(100% - 60px); /* Usa quase toda a largura do PC */
    max-width: none;
    margin: 20px auto; /* Centraliza horizontalmente */
    padding: 25px 30px; /* Padding maior */
  }

  .combo-sleeve-title {
    font-size: 26px; /* Maior */
    padding-top: 20px;
    margin-bottom: 8px;
  }

  .combo-sleeve-sub {
    font-size: 16px; /* Maior */
    margin-bottom: 16px;
  }

  .combo-sleeve-products {
    gap: 20px; /* Espaçamento maior entre produtos */
  }

  .combo-item {
    padding: 15px 12px; /* Maior padding interno */
    border-radius: 10px; /* Levemente maior */
  }

  .combo-item img {
    max-width: 120px; /* Maior imagem */
  }

  .compare {
    font-size: 14px;
  }

  .actual {
    font-size: 16px;
  }

  .combo-plus {
    font-size: 36px; /* Maior */
  }

  .combo-sleeve-total {
    font-size: 16px; /* Maior */
    gap: 10px;
    margin-top: 15px;
    margin-bottom: 20px;
  }

  .total-compare {
    font-size: 14px;
  }

  .total-final {
    font-size: 18px;
  }

  .bundle-badge {
    font-size: 12px;
    padding: 5px 12px;
    border-radius: 5px;
  }

  .badge-icon {
    width: 12px;
    height: 12px;
  }

  .combo-sleeve-button {
    max-width: 90%;     /* garante responsividade */
    margin: 0 auto;     /* centraliza o botão */
    display: block;
  }
}


@keyframes combo-sleeve-pulse-natal {
  0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(255,0,0,.25); }
  50% { transform: scale(1.06); box-shadow: 0 0 16px 6px rgba(255,0,0,.18); }
  100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(255,0,0,.25); }
}
</style>

{% endif %}
