<!-- ============================================================
     1of1 – Aprovado por Atletas
     Colar como Custom HTML no Shopify
     ============================================================ -->

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,400;0,500;0,600;0,700;0,800;1,700;1,800&display=swap" rel="stylesheet">

<style>
/* ── Reset localizado ── */
.oof-wrap *,
.oof-wrap *::before,
.oof-wrap *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

/* ── Wrapper ── */
.oof-wrap {
  font-family: 'Montserrat', sans-serif;
  background: #fff;
  overflow: hidden;
  padding: 15px;
  max-width: 1000px;
  margin: 0 auto;
}

/* ── Header ── */
.oof-header {
  text-align: center;
  margin-bottom: 20px;
  margin-top: 20px;
}

.oof-eyebrow {
  display: block;
  font-family: 'Montserrat', sans-serif;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: .18em;
  text-transform: uppercase;
  color: #4f92c7;
  margin-top: 10px;
}

.oof-title {
  font-family: 'Montserrat', sans-serif;
  font-size: clamp(28px, 5vw, 44px);
  font-weight: 800;
  line-height: 1.1;
  color: #111;
}

/* ── Scroll-snap track ── */
.oof-track {
  display: grid;
  grid-auto-flow: column;
  grid-auto-columns: 82%;
  gap: 12px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  -webkit-overflow-scrolling: touch;
  scroll-behavior: smooth;
  scrollbar-width: none;
  padding: 0 20px 6px;
}

.oof-track::-webkit-scrollbar { display: none; }

@media (min-width: 640px)  { .oof-track { grid-auto-columns: 47%; } }
@media (min-width: 1000px) { .oof-track { grid-auto-columns: 31%; } }

/* ── Card ── */
.oof-card {
  scroll-snap-align: start;
  background: #f2f2f2;
  border-radius: 18px;
  overflow: hidden;
}

/* ── Duas fotos, sem gap ── */
.oof-media {
  display: flex;
  height: 280px;
  overflow: hidden;
}

.oof-media img {
  flex: 1;
  min-width: 0;
  height: 100%;
  object-fit: cover;
  object-position: center top;
  display: block;
}

/* ── Corpo ── */
.oof-body {
  padding: 20px 18px 18px;
}

.oof-quote {
  font-family: 'Montserrat', sans-serif;
  font-size: 13px;
  font-style: italic;
  font-weight: 400;
  line-height: 1.68;
  color: #444;
  margin-bottom: 14px;
}

.oof-quote::before { content: '\201C'; }
.oof-quote::after  { content: '\201D'; }

.oof-name {
  font-family: 'Montserrat', sans-serif;
  font-size: 14px;
  font-weight: 700;
  color: #111;
  display: flex;
  align-items: center;
  gap: 6px;
}

.oof-tick {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 17px;
  height: 17px;
  border-radius: 50%;
  background: #0057ff;
  flex-shrink: 0;
}

.oof-tick.green { background: #00aa5b; }

.oof-tick svg {
  width: 9px;
  height: 9px;
  stroke: #fff;
  fill: none;
  stroke-linecap: round;
  stroke-linejoin: round;
  stroke-width: 3;
}

.oof-role {
  margin-top: 4px;
  font-family: 'Montserrat', sans-serif;
  font-size: 10.5px;
  font-weight: 400;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: rgba(0,0,0,.35);
  margin-bottom: 16px;
}

/* ── CTA produto ── */
.oof-cta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  background: #fff;
  border-radius: 12px;
  padding: 10px 12px;
  text-decoration: none;
  color: inherit;
  transition: background .2s;
}

.oof-cta:hover { background: #ebebeb; }

.oof-cta-left {
  display: flex;
  align-items: center;
  gap: 10px;
  min-width: 0;
}

.oof-thumb {
  width: 44px;
  height: 44px;
  border-radius: 8px;
  overflow: hidden;
  flex-shrink: 0;
  background: #e0e0e0;
}

.oof-thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.oof-cta-info {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.oof-pname {
  font-family: 'Montserrat', sans-serif;
  font-size: 11px;
  font-weight: 600;
  color: #111;
  line-height: 1.3;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 155px;
}

.oof-prices {
  display: flex;
  align-items: center;
  gap: 5px;
  margin-top: 3px;
}

.oof-price-now {
  font-family: 'Montserrat', sans-serif;
  font-size: 12px;
  font-weight: 700;
  color: #111;
}

.oof-price-was {
  font-family: 'Montserrat', sans-serif;
  font-size: 11px;
  color: #bbb;
  text-decoration: line-through;
}

.oof-badge {
  padding: 6px 10px;
  border-radius: 99px;
  background: linear-gradient(90deg, #fb770f, #ffba06);
  flex-shrink: 0;
  font-family: 'Montserrat', sans-serif;
  font-size: 10px;
  font-weight: 700;
  color: #fff;
  letter-spacing: .3px;
  white-space: nowrap;
}

/* ── Setas – sem círculo ── */
.oof-footer {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 30px;
  margin-top: 20px;
  padding: 0 20px;
  margin-bottom: 40px;
}

.oof-arrow {
  background: none;
  border: none;
  cursor: pointer;
  padding: 6px;
  color: #111;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: .4;
  transition: opacity .2s;
  line-height: 0;
}

.oof-arrow:hover { opacity: 1; }

.oof-arrow svg {
  width: 25px;
  height: 25px;
  stroke: currentColor;
  fill: none;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
}
</style>


