<style>
  @font-face {
    font-family: 'Poppins Medium';
    src: url('https://cdn.shopify.com/s/files/1/0907/8472/7374/files/poppins.medium.ttf?v=1747688794') format('truetype');
    font-weight: 500;
    font-style: normal;
  }

  /* Ocultar em telas maiores (a partir de 768px) */
  @media screen and (min-width: 768px) {
    .collections-wrapper {
      display: none !important;
    }
  }

@media screen and (max-width: 767px) {
  .collections-wrapper {
    background: #000000;
    padding: 10px 0;
    max-width: 800px;
    margin: 0 auto;
  }

  .collections-row {
    display: flex;
    justify-content: center; /* centraliza */
    align-items: center;
    gap: 17px; /* espaçamento fixo entre itens */
    padding: 0px 10px; /* 10px de margem lateral da borda do tele */
    margin-top: 10px;
    margin-bottom:5px;
  }

  .collection-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 1; /* faz os itens crescerem igualmente */
    max-width: 70px; /* controla a largura */
    text-align: center;
    font-family: 'Poppins Medium', sans-serif !important;
    text-decoration: none;
    color: black !important;
  }

  .collection-item img {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    border: 1.2px solid #000;
    padding: 3px;
    background: white;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .collection-item:hover img {
    transform: scale(1.05);
  }

  .collection-item span {
    display: block;
    margin-top: 4px;
    font-size: 11px;
    font-weight: 500;
    text-transform: capitalize;
  }
}



</style>

<div class="collections-wrapper">
  <div class="collections-row">
    {% assign lang_prefix = '' %}
    {% if localization.language.iso_code == 'pt' or localization.language.iso_code contains 'pt' %}
      {% assign lang_prefix = '/pt' %}
    {% elsif localization.language.iso_code == 'es' or localization.language.iso_code contains 'es' %}
      {% assign lang_prefix = '/es' %}
    {% endif %}

    <a href="{{ lang_prefix }}/collections/best-sellers" class="collection-item">
      <img src="https://cdn.shopify.com/s/files/1/0907/8472/7374/files/Texto_do_seu_paragrafo_2.png?v=1749127833" alt="{{ 'collections_row.bestsellers_alt' | t }}" />
      <span>{{ 'collections_row.bestsellers' | t }}</span>
    </a>

    <a href="{{ lang_prefix }}/collections/shin-pads" class="collection-item">
      <img src="https://cdn.shopify.com/s/files/1/0907/8472/7374/files/Texto_do_seu_paragrafo_1.png?v=1749127832" alt="{{ 'collections_row.shin_pads_alt' | t }}" />
      <span>{{ 'collections_row.shin_pads' | t }}</span>
    </a>

    <a href="{{ lang_prefix }}/collections/socks" class="collection-item">
      <img src="https://cdn.shopify.com/s/files/1/0907/8472/7374/files/Texto_do_seu_paragrafo_798c6456-84d1-4d8c-b989-c1b9bef15911.png?v=1749127961" alt="{{ 'collections_row.socks_alt' | t }}" />
      <span>{{ 'collections_row.socks' | t }}</span>
    </a>

    <a href="{{ lang_prefix }}/collections/bundles" class="collection-item">
      <img src="https://cdn.shopify.com/s/files/1/0907/8472/7374/files/aasd.png?v=1749127830" alt="{{ 'collections_row.bundles_alt' | t }}" />
      <span>{{ 'collections_row.bundles' | t }}</span>
    </a>
  </div>
</div>
