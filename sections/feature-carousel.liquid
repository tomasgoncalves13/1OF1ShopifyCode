<style>
  @font-face {
    font-family: 'Poppins ExtraBold';
    src: url('https://cdn.shopify.com/s/files/1/0907/8472/7374/files/poppins.extrabold.ttf?v=1747688794') format('truetype');
    font-weight: 800;
    font-style: normal;
  }

  @font-face {
    font-family: 'Questrial';
    src: url('https://cdn.shopify.com/s/files/1/0907/8472/7374/files/Questrial-Regular.ttf?v=1746300481') format('truetype');
    font-weight: normal;
    font-style: normal;
  }

  .feature-unique-carousel {
    width: 100%;
    overflow: hidden;
    background: fff;
    padding: 12px 0px;
  }

  .feature-unique-track {
    display: inline-block;
    white-space: nowrap;
    animation: featureScrollLoop 100s linear infinite;
  }

  .feature-unique-item {
    display: inline-block;
    font-family: 'Questrial', sans-serif;
    text-align: center;
    vertical-align: top;
    width: 100px;
  }

  .content-wrapper {
    /* mobile: vertical */
    display: block;
  }

  .feature-unique-item img {
    height: 30px;
    width: auto;
    display: block;
    margin: 0 auto 5px auto;
  }

  .feature-unique-text {
    font-size: 0.8rem;
    color: #000;
    white-space: normal;
    max-width: 100%;
    margin: 0 auto;
    line-height: 1.3;
  }

  @keyframes featureScrollLoop {
    0% {
      transform: translateX(0%);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  /* Linhas pretas topo mobile e desktop */
  .mobile-top-line {
    width: 100%;
    height: 1px;
    background-color: #000;
  }
  .desktop-top-line {
    display: none;
  }

  /* Desktop */
  @media (min-width: 768px) {
    .desktop-top-line {
      display: block;
      width: 100%;
      height: 1px;
      background-color: #000;
      position: relative;
      z-index: 5;
      margin-bottom: 12px;
    }

  .feature-unique-item {
    width: 200px; /* opcional: aumenta um pouco a largura pra caber melhor */
    margin: 0 60px; /* aumenta o espaço entre os ícones */
  }

    .content-wrapper {
      display: flex;
      align-items: center;
      justify-content: flex-start;
    }

    .feature-unique-item img {
      height: 60px;
      margin-right: 20px;
      margin-bottom: 0;
    }

  .feature-unique-text {
    font-size: 1.4rem; /* aumentei de 1.1rem para 1.3rem */
  }

      .feature-unique-carousel {
    padding: 25px 0; /* aumenta o padding em cima e embaixo */
  }
  }
  @media (min-width: 768px) {
  /* força esconder a linha duplicada de cima no desktop */
  .feature-unique-carousel:first-of-type {
    display: none !important;
  }
}

</style>

<div style="background-color: fff; overflow: hidden; position: relative;">
  <!-- Linha preta topo mobile -->
  <div class="mobile-top-line"></div>
  <!-- Linha preta topo desktop -->
  <div class="desktop-top-line"></div>

  <!-- Carrossel -->
  <div class="feature-unique-carousel">
    <div class="feature-unique-track">
      {% for i in (1..5) %}
        <div class="feature-unique-item">
          <div class="content-wrapper">
            <img src="https://cdn.shopify.com/s/files/1/0907/8472/7374/files/Icons_17.png?v=1748474673" alt="{{ 'features.secure_payments_alt' | t }}">
            <div class="feature-unique-text">{{ 'features.secure_payments' | t }}</div>
          </div>
        </div>

        <div class="feature-unique-item">
          <div class="content-wrapper">
            <img src="https://cdn.shopify.com/s/files/1/0907/8472/7374/files/Icons_2_be815222-aa5a-4a0d-b7db-63a3a5787f1a.png?v=1748474355" alt="{{ 'features.guarantee_alt' | t }}">
            <div class="feature-unique-text">{{ 'features.guarantee' | t }}</div>
          </div>
        </div>

        <div class="feature-unique-item">
          <div class="content-wrapper">
            <img src="https://cdn.shopify.com/s/files/1/0907/8472/7374/files/Icons_12.png?v=1748474352" alt="{{ 'features.trusted_alt' | t }}">
            <div class="feature-unique-text">{{ 'features.trusted' | t }}</div>
          </div>
        </div>

        <div class="feature-unique-item">
          <div class="content-wrapper">
            <img src="https://cdn.shopify.com/s/files/1/0907/8472/7374/files/Icons_18.png?v=1748474924" alt="{{ 'features.free_shipping_alt' | t }}">
            <div class="feature-unique-text">{{ 'features.free_shipping' | t }}</div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<!-- Linha preta inferior -->
<div style="width: 100vw; height: 1px; background-color: black; display: block; position: relative; z-index: 5;"></div>
